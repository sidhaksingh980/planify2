# Planify — local environment. Copy to `.env.local` and fill in.
#
# Only VITE_* values reach the browser. The Supabase anon key is a *publishable*
# key: it is safe to expose because authorisation is enforced by Row Level
# Security (supabase/migrations/0001_init.sql), not by key secrecy.
#
# Everything below the "SERVER ONLY" line is read exclusively by server/index.mjs
# and must never be prefixed with VITE_.

# ---------------------------------------------------------------------------
# Cloud database + Google sign-in  (client-visible)
# ---------------------------------------------------------------------------
# Leave both blank to run in on-device mode (IndexedDB, no Google sign-in).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Force on-device mode even when the two values above are set.
VITE_FORCE_LOCAL=false

# ---------------------------------------------------------------------------
# SERVER ONLY — never add the VITE_ prefix to these
# ---------------------------------------------------------------------------
# AI. Supply either key; the assistant works without one using the built-in
# on-device parser, and the key is used only to fill gaps the parser cannot.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PLANIFY_LLM_MODEL=

# Google Calendar (optional, separate from sign-in).
# Create an OAuth client of type "Web application" in Google Cloud Console,
# enable the Google Calendar API, and set the redirect URI to the callback below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/gcal/callback

# Where the API server listens. Vite proxies /api to this port.
API_HOST=0.0.0.0
API_PORT=8787
