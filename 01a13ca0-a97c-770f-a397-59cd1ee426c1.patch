--- /dev/null
+++ b/src/components/calendar/Toolbar.tsx
@@ -0,0 +1,151 @@
+/**
+ * Toolbar — the floating glass control bar above the grid.
+ *
+ * Holds: title for the visible range, previous/today/next, the view switcher and
+ * search. On phones it collapses to a compact rail so the grid keeps the screen.
+ */
+import { memo } from 'react';
+import { cx } from '../../lib/utils';
+import { formatMonthTitle, formatRangeTitle } from '../../lib/dates';
+import type { CalendarViewMode } from '../../types';
+import { Icon, type IconName } from '../ui/Icon';
+import { IconButton } from '../ui/Button';
+import { Segmented } from '../ui/Controls';
+
+export interface ToolbarProps {
+  view: CalendarViewMode;
+  onViewChange: (v: CalendarViewMode) => void;
+  title: string;
+  onPrev: () => void;
+  onNext: () => void;
+  onToday: () => void;
+  onToggleSearch: () => void;
+  searchActive: boolean;
+  isMobile: boolean;
+  /** e.g. "March 2027" vs a range — computed by the parent. */
+  subtitle?: string;
+}
+
+const VIEW_OPTIONS: Array<{ value: CalendarViewMode; label: string; icon: IconName; short: string }> = [
+  { value: 'month', label: 'Month', icon: 'grid', short: 'M' },
+  { value: 'week', label: 'Week', icon: 'columns', short: 'W' },
+  { value: 'day', label: 'Day', icon: 'square', short: 'D' },
+  { value: 'agenda', label: 'Agenda', icon: 'list', short: 'A' },
+];
+
+export const Toolbar = memo(function Toolbar({
+  view,
+  onViewChange,
+  title,
+  onPrev,
+  onNext,
+  onToday,
+  onToggleSearch,
+  searchActive,
+  isMobile,
+  subtitle,
+}: ToolbarProps) {
+  return (
+    <div className="shrink-0 px-2 pb-2 pt-2 sm:px-4 sm:pt-3">
+      <div className="glass flex items-center gap-1.5 rounded-[18px] px-1.5 py-1.5 sm:gap-2 sm:px-2.5 sm:py-2">
+        {/* Title + navigation */}
+        <div className="flex min-w-0 flex-1 items-center gap-1">
+          <div className="min-w-0 px-1.5">
+            <h1
+              className="truncate font-display text-[15px] font-semibold leading-tight tracking-[-0.02em] text-ink sm:text-[17px]"
+              aria-live="polite"
+            >
+              {title}
+            </h1>
+            {subtitle && !isMobile ? (
+              <p className="truncate text-[11px] leading-tight text-ink3">{subtitle}</p>
+            ) : null}
+          </div>
+
+          <div className="ml-auto flex items-center gap-1 sm:ml-1">
+            <IconButton
+              icon="today"
+              label="Go to today"
+              size="sm"
+              variant="ghost"
+              onClick={onToday}
+              className="hidden sm:inline-flex"
+            />
+            <IconButton icon="chevronLeft" label="Previous" size="sm" variant="ghost" onClick={onPrev} />
+            <IconButton icon="chevronRight" label="Next" size="sm" variant="ghost" onClick={onNext} />
+            {isMobile ? (
+              <IconButton
+                icon="today"
+                label="Go to today"
+                size="sm"
+                variant="ghost"
+                onClick={onToday}
+              />
+            ) : null}
+          </div>
+        </div>
+
+        {/* Search */}
+        <IconButton
+          icon="search"
+          label={searchActive ? 'Close search' : 'Search events'}
+          size="sm"
+          variant="ghost"
+          active={searchActive}
+          onClick={onToggleSearch}
+        />
+
+        {/* View switcher */}
+        {isMobile ? (
+          <MobileViewSwitch value={view} onChange={onViewChange} />
+        ) : (
+          <Segmented
+            value={view}
+            onChange={onViewChange}
+            ariaLabel="Calendar view"
+            size="sm"
+            options={VIEW_OPTIONS.map((o) => ({ value: o.value, label: o.label, icon: o.icon }))}
+            className="ml-0.5"
+          />
+        )}
+      </div>
+    </div>
+  );
+});
+
+/**
+ * On phones a 4-way segmented control is too wide next to the title, so the
+ * switcher becomes a single button that cycles the views — with the current view
+ * named, and a long-press-free second path via the bottom nav.
+ */
+function MobileViewSwitch({
+  value,
+  onChange,
+}: {
+  value: CalendarViewMode;
+  onChange: (v: CalendarViewMode) => void;
+}) {
+  const current = VIEW_OPTIONS.find((o) => o.value === value) ?? VIEW_OPTIONS[0];
+  const next = () => {
+    const i = VIEW_OPTIONS.findIndex((o) => o.value === value);
+    onChange(VIEW_OPTIONS[(i + 1) % VIEW_OPTIONS.length].value);
+  };
+
+  return (
+    <button
+      type="button"
+      onClick={next}
+      aria-label={`View: ${current.label}. Tap to change view.`}
+      className={cx(
+        'pressable inline-flex h-8 shrink-0 items-center gap-1.5 rounded-[11px]',
+        'bg-[rgb(var(--c-raised))] px-2.5 text-[12.5px] font-semibold text-ink',
+        'shadow-[0_1px_2px_rgb(0_0_0/0.25),inset_0_1px_0_rgb(255_255_255/0.08)]',
+      )}
+    >
+      <Icon name={current.icon} size={14} weight={1.9} />
+      {current.label}
+    </button>
+  );
+}
+
+export { VIEW_OPTIONS, formatMonthTitle, formatRangeTitle };
diff --git a/src/components/ui/Button.tsx b/src/components/ui/Button.tsx
new file mode 100644
index 0000000..1797cd4
--- /dev/null
+++ b/src/components/ui/Button.tsx
@@ -0,0 +1,174 @@
+/**
+ * Buttons.
+ *
+ * Four visual weights:
+ *   `primary`  — accent fill, white text (verified 5.9:1 dark / 5.4:1 light)
+ *   `glass`    — translucent glass, the default for toolbars and nav
+ *   `subtle`   — quiet, for tertiary actions
+ *   `danger`   — destructive; always paired with a confirmation step
+ *
+ * Every button gets the `.pressable` micro-interaction and a visible
+ * `:focus-visible` ring for keyboard users.
+ */
+import { forwardRef, type ButtonHTMLAttributes, type ReactNode } from 'react';
+import { cx, haptic } from '../../lib/utils';
+import { Icon, type IconName } from './Icon';
+
+export type ButtonVariant = 'primary' | 'glass' | 'subtle' | 'danger' | 'ghost';
+export type ButtonSize = 'sm' | 'md' | 'lg';
+
+export interface ButtonProps extends ButtonHTMLAttributes<HTMLButtonElement> {
+  variant?: ButtonVariant;
+  size?: ButtonSize;
+  icon?: IconName;
+  iconRight?: IconName;
+  loading?: boolean;
+  block?: boolean;
+  children?: ReactNode;
+}
+
+const VARIANTS: Record<ButtonVariant, string> = {
+  primary: cx(
+    'glass-none text-[rgb(var(--c-accent-ink))] border-transparent',
+    'bg-accent hover:brightness-110 active:brightness-95',
+    'shadow-[0_1px_2px_rgb(0_0_0/0.25),0_8px_20px_-6px_rgb(var(--c-accent)/0.55)]',
+  ),
+  glass: cx(
+    'glass text-ink hover:bg-[var(--glass-bg-strong)]',
+    'border-[var(--glass-border-soft)]',
+  ),
+  subtle: cx(
+    'bg-[rgb(var(--c-line)/0.07)] text-ink2 border border-transparent',
+    'hover:bg-[rgb(var(--c-line)/0.12)] hover:text-ink',
+  ),
+  danger: cx(
+    'bg-danger/14 text-danger border border-danger/28',
+    'hover:bg-danger/22 hover:border-danger/45',
+  ),
+  ghost: cx('bg-transparent text-ink2 border border-transparent hover:bg-[rgb(var(--c-line)/0.08)] hover:text-ink'),
+};
+
+const SIZES: Record<ButtonSize, string> = {
+  sm: 'h-8 px-3 text-[13px] gap-1.5 rounded-xl',
+  md: 'h-10 px-4 text-sm gap-2 rounded-[14px]',
+  lg: 'h-12 px-5 text-[15px] gap-2.5 rounded-2xl',
+};
+
+export const Button = forwardRef<HTMLButtonElement, ButtonProps>(function Button(
+  {
+    variant = 'glass',
+    size = 'md',
+    icon,
+    iconRight,
+    loading = false,
+    block = false,
+    className,
+    children,
+    disabled,
+    onClick,
+    type = 'button',
+    ...rest
+  },
+  ref,
+) {
+  const isGlass = variant === 'glass';
+  const iconSize = size === 'sm' ? 15 : size === 'lg' ? 19 : 17;
+
+  return (
+    <button
+      ref={ref}
+      type={type}
+      disabled={disabled || loading}
+      aria-busy={loading || undefined}
+      onClick={(e) => {
+        haptic(6);
+        onClick?.(e);
+      }}
+      className={cx(
+        'pressable relative inline-flex select-none items-center justify-center',
+        'font-medium tracking-[-0.01em] whitespace-nowrap',
+        'disabled:pointer-events-none disabled:opacity-45',
+        isGlass ? 'glass' : '',
+        variant === 'primary' ? 'primary-fill' : '',
+        SIZES[size],
+        VARIANTS[variant],
+        block && 'w-full',
+        className,
+      )}
+      {...rest}
+    >
+      {loading ? (
+        <Spinner size={iconSize} />
+      ) : icon ? (
+        <Icon name={icon} size={iconSize} weight={1.8} />
+      ) : null}
+      {children}
+      {iconRight && !loading ? <Icon name={iconRight} size={iconSize} weight={1.8} /> : null}
+    </button>
+  );
+});
+
+/** Icon-only button — always carries an accessible label. */
+export interface IconButtonProps extends ButtonHTMLAttributes<HTMLButtonElement> {
+  icon: IconName;
+  label: string;
+  variant?: ButtonVariant;
+  size?: ButtonSize;
+  active?: boolean;
+}
+
+export const IconButton = forwardRef<HTMLButtonElement, IconButtonProps>(function IconButton(
+  { icon, label, variant = 'glass', size = 'md', active = false, className, onClick, ...rest },
+  ref,
+) {
+  const box =
+    size === 'sm' ? 'h-8 w-8 rounded-xl' : size === 'lg' ? 'h-12 w-12 rounded-2xl' : 'h-10 w-10 rounded-[14px]';
+  const iconSize = size === 'sm' ? 15 : size === 'lg' ? 20 : 18;
+
+  return (
+    <button
+      ref={ref}
+      type="button"
+      aria-label={label}
+      title={label}
+      aria-pressed={active || undefined}
+      onClick={(e) => {
+        haptic(6);
+        onClick?.(e);
+      }}
+      className={cx(
+        'pressable relative inline-flex shrink-0 items-center justify-center',
+        variant === 'glass' ? 'glass' : '',
+        box,
+        VARIANTS[variant],
+        active && 'text-accent bg-accent/14 border-accent/30',
+        className,
+      )}
+      {...rest}
+    >
+      <Icon name={icon} size={iconSize} weight={1.8} />
+    </button>
+  );
+});
+
+export function Spinner({ size = 16, className }: { size?: number; className?: string }) {
+  return (
+    <svg
+      width={size}
+      height={size}
+      viewBox="0 0 24 24"
+      fill="none"
+      className={cx('animate-spin', className)}
+      aria-hidden="true"
+      focusable="false"
+    >
+      <circle cx="12" cy="12" r="9" stroke="currentColor" strokeOpacity="0.22" strokeWidth="2.4" />
+      <path
+        d="M21 12a9 9 0 0 0-9-9"
+        stroke="currentColor"
+        strokeWidth="2.4"
+        strokeLinecap="round"
+      />
+    </svg>
+  );
+}
diff --git a/src/components/ui/Controls.tsx b/src/components/ui/Controls.tsx
new file mode 100644
index 0000000..e00c91e
--- /dev/null
+++ b/src/components/ui/Controls.tsx
@@ -0,0 +1,501 @@
+/**
+ * Form controls styled for glass: labels, inputs, textareas, native selects
+ * (with a custom chevron), a real switch, a segmented control, colour/category
+ * swatches and a chip.
+ *
+ * Native `<input type="date">` / `type="time">` are used deliberately: on iOS
+ * and Android they open the platform wheel pickers, which is both faster and
+ * more accessible than a custom calendar-in-a-calendar.
+ */
+import {
+  forwardRef,
+  useId,
+  type InputHTMLAttributes,
+  type ReactNode,
+  type SelectHTMLAttributes,
+  type TextareaHTMLAttributes,
+} from 'react';
+import { cx } from '../../lib/utils';
+import { Icon, type IconName } from './Icon';
+
+/* -------------------------------------------------------------------------- */
+/* Field wrapper                                                               */
+/* -------------------------------------------------------------------------- */
+
+export interface FieldProps {
+  label: string;
+  htmlFor?: string;
+  hint?: ReactNode;
+  error?: string | null;
+  required?: boolean;
+  children: ReactNode;
+  className?: string;
+  action?: ReactNode;
+}
+
+export function Field({
+  label,
+  htmlFor,
+  hint,
+  error,
+  required,
+  children,
+  className,
+  action,
+}: FieldProps) {
+  return (
+    <div className={cx('min-w-0', className)}>
+      <div className="mb-1.5 flex items-baseline justify-between gap-2">
+        <label
+          htmlFor={htmlFor}
+          className="text-[11.5px] font-semibold uppercase tracking-[0.06em] text-ink3"
+        >
+          {label}
+          {required ? <span className="ml-0.5 text-danger">*</span> : null}
+        </label>
+        {action}
+      </div>
+      {children}
+      {error ? (
+        <p className="mt-1.5 flex items-center gap-1.5 text-[12.5px] font-medium text-danger" role="alert">
+          <Icon name="alert" size={13} weight={2} />
+          {error}
+        </p>
+      ) : hint ? (
+        <p className="mt-1.5 text-[12.5px] leading-snug text-ink3">{hint}</p>
+      ) : null}
+    </div>
+  );
+}
+
+/* -------------------------------------------------------------------------- */
+/* Shared input surface                                                        */
+/* -------------------------------------------------------------------------- */
+
+const INPUT_BASE = cx(
+  'w-full rounded-[13px] border bg-[rgb(var(--c-surface)/0.9)] px-3 text-[14.5px] text-ink',
+  'placeholder:text-ink3/70 transition-[border-color,box-shadow,background-color] duration-150',
+  'focus:border-accent/60 focus:bg-[rgb(var(--c-surface))] focus:outline-none',
+  'focus-visible:shadow-focus',
+  'disabled:cursor-not-allowed disabled:opacity-50',
+);
+
+/* -------------------------------------------------------------------------- */
+/* TextInput                                                                   */
+/* -------------------------------------------------------------------------- */
+
+export interface TextInputProps extends InputHTMLAttributes<HTMLInputElement> {
+  invalid?: boolean;
+  iconLeft?: IconName;
+  trailing?: ReactNode;
+}
+
+export const TextInput = forwardRef<HTMLInputElement, TextInputProps>(function TextInput(
+  { className, invalid, iconLeft, trailing, ...rest },
+  ref,
+) {
+  if (iconLeft || trailing) {
+    return (
+      <div className="relative">
+        {iconLeft ? (
+          <span className="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink3">
+            <Icon name={iconLeft} size={16} />
+          </span>
+        ) : null}
+        <input
+          ref={ref}
+          className={cx(
+            INPUT_BASE,
+            'h-11',
+            iconLeft && 'pl-9',
+            trailing ? 'pr-10' : '',
+            invalid ? 'border-danger/60' : 'border-[rgb(var(--c-line)/var(--line-alpha))]',
+            className,
+          )}
+          aria-invalid={invalid || undefined}
+          {...rest}
+        />
+        {trailing ? (
+          <span className="absolute right-2 top-1/2 -translate-y-1/2">{trailing}</span>
+        ) : null}
+      </div>
+    );
+  }
+
+  return (
+    <input
+      ref={ref}
+      className={cx(
+        INPUT_BASE,
+        'h-11',
+        invalid ? 'border-danger/60' : 'border-[rgb(var(--c-line)/var(--line-alpha))]',
+        className,
+      )}
+      aria-invalid={invalid || undefined}
+      {...rest}
+    />
+  );
+});
+
+/* -------------------------------------------------------------------------- */
+/* TextArea                                                                    */
+/* -------------------------------------------------------------------------- */
+
+export interface TextAreaProps extends TextareaHTMLAttributes<HTMLTextAreaElement> {
+  invalid?: boolean;
+}
+
+export const TextArea = forwardRef<HTMLTextAreaElement, TextAreaProps>(function TextArea(
+  { className, invalid, rows = 3, ...rest },
+  ref,
+) {
+  return (
+    <textarea
+      ref={ref}
+      rows={rows}
+      className={cx(
