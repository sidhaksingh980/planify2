+      };
+    },
+
+    async saveGoogleLink(userId, link) {
+      await supabase.from('google_calendar_links').upsert(
+        {
+          user_id: userId,
+          connected: link.connected,
+          email: link.email ?? null,
+          calendar_id: link.calendarId ?? null,
+          status: link.status,
+          last_sync_at: link.lastSyncAt,
