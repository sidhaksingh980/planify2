+    },
+
+    getStatus() {
+      return status;
+    },
+
+    onStatusChange(cb) {
+      statusListeners.add(cb);
+      return { unsubscribe: () => statusListeners.delete(cb) };
+    },
+
+    async flush() {
+      return flushOutbox();
+    },
+  };
+}
