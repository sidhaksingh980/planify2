+        firstDayOfWeek: ((data.first_day_of_week as number) ?? DEFAULT_SETTINGS.firstDayOfWeek) as UserSettings['firstDayOfWeek'],
+        timeFormat: (data.time_format as UserSettings['timeFormat']) ?? DEFAULT_SETTINGS.timeFormat,
