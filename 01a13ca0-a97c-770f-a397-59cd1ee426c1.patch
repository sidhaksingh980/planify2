@@ -0,0 +1,42 @@
+/**
+ * Provider selection.
+ *
+ * Cloud mode wins whenever valid Supabase credentials are present, unless the
+ * developer explicitly forces local mode with `VITE_FORCE_LOCAL=true`.
+ */
+import { createLocalProvider } from './local';
+import { createCloudProvider, supabaseEnv } from './supabase';
+import type { DataProvider } from './types';
+
+let instance: DataProvider | null = null;
+let initPromise: Promise<DataProvider> | null = null;
+
+export function getProvider(): DataProvider {
+  if (instance) return instance;
+
+  const forced = (import.meta.env.VITE_FORCE_LOCAL ?? '').toLowerCase();
+  const env = forced === 'true' || forced === '1' ? null : supabaseEnv();
+
+  instance = env ? createCloudProvider(env.url, env.anonKey) : createLocalProvider();
+  return instance;
+}
+
+export async function initProvider(): Promise<DataProvider> {
+  const p = getProvider();
+  if (!initPromise) {
+    initPromise = p
+      .init()
+      .catch((err) => {
+        console.error('[planify] provider init failed, falling back to device storage', err);
+        // Never leave the app unusable: fall back to the local provider.
+        instance = createLocalProvider();
+        initPromise = instance.init().then(() => instance as DataProvider);
+        return initPromise;
+      })
+      .then(() => p);
+  }
+  return initPromise;
+}
+
+export type { DataProvider, AuthSession, Subscription } from './types';
+export { mergeEvent, eventFromRow, eventToRow } from './types';
diff --git a/src/lib/providers/local.ts b/src/lib/providers/local.ts
new file mode 100644
index 0000000..77287c9
--- /dev/null
+++ b/src/lib/providers/local.ts
@@ -0,0 +1,357 @@
+/**
+ * Local (on-device) provider.
+ *
+ * This is a real, durable store — IndexedDB — not an in-memory stub. Events
+ * created here survive reloads, tab restarts, sign-out/sign-in, and browser
+ * restarts. It is the default until Supabase credentials are supplied, and it
+ * also serves as the offline cache for cloud mode.
+ *
+ * What it is NOT: a cross-device store, and not a Google account. The UI is
+ * explicit about that with a persistent "On this device" badge plus a
+ * one-tap path to connect Supabase. Nothing here fabricates calendar data —
+ * a new account begins with zero events.
+ */
+import {
+  DEFAULT_SETTINGS,
+  type AuthProvider,
+  type CalEvent,
+  type ChatMessage,
+  type DataStatus,
+  type GoogleCalendarLink,
+  type UserProfile,
+  type UserSettings,
+} from '../../types';
+import { newId } from '../utils';
+import {
+  idbClearChat,
+  idbDeleteEvent,
+  idbDeleteMeta,
+  idbDeleteOutbox,
+  idbGetAccount,
+  idbGetMeta,
+  idbGetSettings,
+  idbListChat,
+  idbListEvents,
+  idbListOutbox,
+  idbPutAccount,
+  idbPutChat,
+  idbPutEvent,
+  idbPutEvents,
+  idbPutMeta,
+  idbPutOutbox,
+  idbPutSettings,
+  idbWipeUserData,
+} from './idb';
+import type { AuthSession, DataProvider } from './types';
+import { mergeEvent } from './types';
+
+const SESSION_KEY = 'planify:local:session';
+const LINK_KEY = 'planify:local:gcal';
+
+type Listener<T> = (v: T) => void;
+
+function emit<T>(set: Set<Listener<T>>, value: T) {
+  set.forEach((fn) => {
+    try {
+      fn(value);
+    } catch (err) {
+      console.error('[planify:local] listener threw', err);
+    }
+  });
+}
+
+export function createLocalProvider(): DataProvider {
+  let session: AuthSession | null = null;
+  const authListeners = new Set<Listener<AuthSession | null>>();
+  const eventListeners = new Map<string, Set<Listener<CalEvent[]>>>();
+  const settingsListeners = new Map<string, Set<Listener<UserSettings>>>();
+  const chatListeners = new Map<string, Set<Listener<ChatMessage[]>>>();
+  const statusListeners = new Set<Listener<DataStatus>>();
+
+  let status: DataStatus = {
+    state: 'idle',
+    pending: 0,
+    lastSyncedAt: null,
+    message: null,
+    mode: 'device',
+  };
+
+  function setStatus(patch: Partial<DataStatus>) {
+    status = { ...status, ...patch };
+    emit(statusListeners, status);
+  }
+
+  async function refreshOutboxCount() {
+    const out = await idbListOutbox();
+    if (out.length !== status.pending) setStatus({ pending: out.length });
+  }
+
+  async function notifyEvents(userId: string) {
+    const set = eventListeners.get(userId);
+    if (!set?.size) return;
+    emit(set, await idbListEvents(userId));
+  }
+
+  async function notifyChat(userId: string) {
+    const set = chatListeners.get(userId);
+    if (!set?.size) return;
+    emit(set, await idbListChat(userId));
+  }
+
+  return {
+    id: 'device',
+    label: 'On this device',
+    description:
+      'Your calendar is stored securely in this browser (IndexedDB). It works fully offline and survives reloads, but it will not appear on your other devices until you connect a cloud database.',
+
+    async init() {
+      const stored = await idbGetMeta<AuthSession>(SESSION_KEY);
+      if (stored?.user) {
+        const fresh = await idbGetAccount().catch(() => null);
+        session = fresh ? { user: fresh, accessToken: null } : stored;
+      }
+      await refreshOutboxCount();
+      setStatus({ state: 'idle', mode: 'device' });
+    },
+
+    async getSession() {
+      return session;
+    },
+
+    onAuthChange(cb) {
+      authListeners.add(cb);
+      return {
+        unsubscribe: () => authListeners.delete(cb),
+      };
+    },
+
+    async signInWithGoogle() {
+      // Google OAuth requires a configured OAuth client and a cloud backend to
+      // exchange the code. We refuse rather than pretending it worked.
+      return {
+        ok: false,
+        error:
+          'Google sign-in needs a cloud backend. Add VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY (see README → “Going live”), then reload. Until then you can continue with an on-device account.',
+      };
+    },
+
+    async signInLocally({ name, email }) {
+      const existing = await idbGetAccount();
+      const now = new Date().toISOString();
+      const provider: AuthProvider = 'local';
+
+      let user: UserProfile;
+      if (existing && existing.provider === 'local') {
+        user = {
+          ...existing,
+          name: name.trim() || existing.name,
+          email: email.trim().toLowerCase() || existing.email,
+          lastSeenAt: now,
+        };
+      } else {
+        user = {
+          id: newId('usr'),
+          email: email.trim().toLowerCase(),
+          name: name.trim(),
+          avatarUrl: null,
+          provider,
+          createdAt: now,
+          lastSeenAt: now,
+          onboardingComplete: false,
+        };
+      }
+
+      await idbPutAccount(user);
+      // Every new account starts with an empty calendar. No seeding, ever.
+      const existingSettings = await idbGetSettings(user.id);
+      if (!existingSettings) {
+        await idbPutSettings(user.id, {
+          ...DEFAULT_SETTINGS,
+          timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC',
+        });
+      }
+      session = { user, accessToken: null };
+      await idbPutMeta(SESSION_KEY, session);
+      emit(authListeners, session);
+      return session;
+    },
+
+    async signOut() {
+      session = null;
+      await idbDeleteMeta(SESSION_KEY);
+      emit(authListeners, null);
+    },
+
+    async updateProfile(patch) {
+      if (!session?.user) return null;
+      const user: UserProfile = { ...session.user, ...patch };
+      await idbPutAccount(user);
+      session = { user, accessToken: null };
+      await idbPutMeta(SESSION_KEY, session);
+      emit(authListeners, session);
+      return user;
+    },
+
+    async deleteAccount() {
+      const userId = session?.user?.id;
+      if (userId) {
+        // idbWipeUserData removes the events, chat, settings and profile row.
+        await idbWipeUserData(userId);
+      }
+      await idbDeleteMeta(SESSION_KEY);
+      await idbDeleteMeta(LINK_KEY);
+      session = null;
+      emit(authListeners, null);
+    },
+
+    async listEvents(userId) {
+      return idbListEvents(userId);
+    },
+
+    async getEvent(_userId, id) {
+      const rows = await idbListEvents(_userId);
+      return rows.find((r) => r.id === id) ?? null;
+    },
+
+    async upsertEvent(event) {
+      const existing = (await idbListEvents(event.userId)).find((e) => e.id === event.id);
+      const merged = existing ? mergeEvent(existing, event) : event;
+      await idbPutEvent(merged);
+      await notifyEvents(merged.userId);
+      return merged;
+    },
+
+    async deleteEvent(userId, id) {
+      // Hard delete locally; the tombstone path is used by cloud mode so that
+      // removals propagate to other signed-in devices.
+      await idbDeleteEvent(id);
+      await notifyEvents(userId);
+    },
+
+    async upsertEvents(events) {
+      if (!events.length) return [];
+      await idbPutEvents(events);
+      const userIds = [...new Set(events.map((e) => e.userId))];
+      await Promise.all(userIds.map(notifyEvents));
+      return events;
+    },
+
+    onEventsChange(userId, cb) {
+      let set = eventListeners.get(userId);
+      if (!set) {
+        set = new Set();
+        eventListeners.set(userId, set);
+      }
+      set.add(cb);
+      return {
+        unsubscribe: () => {
+          set?.delete(cb);
+        },
+      };
+    },
+
+    async getSettings(userId) {
+      return idbGetSettings(userId);
+    },
+
+    async saveSettings(userId, settings) {
+      await idbPutSettings(userId, settings);
+      emit(settingsListeners.get(userId) ?? new Set<Listener<UserSettings>>(), settings);
+      return settings;
+    },
+
+    onSettingsChange(userId, cb) {
+      let set = settingsListeners.get(userId);
+      if (!set) {
+        set = new Set();
+        settingsListeners.set(userId, set);
+      }
+      set.add(cb);
+      return {
+        unsubscribe: () => {
+          set?.delete(cb);
+        },
+      };
+    },
+
+    async listChat(userId) {
+      return idbListChat(userId);
+    },
+
+    async addChatMessage(msg) {
+      await idbPutChat(msg);
+      await notifyChat(msg.userId);
+      return msg;
+    },
+
+    async updateChatMessage(msg) {
+      await idbPutChat(msg);
+      await notifyChat(msg.userId);
+    },
+
+    async clearChat(userId) {
+      await idbClearChat(userId);
+      await notifyChat(userId);
+    },
+
+    onChatChange(userId, cb) {
+      let set = chatListeners.get(userId);
+      if (!set) {
+        set = new Set();
+        chatListeners.set(userId, set);
+      }
+      set.add(cb);
+      return {
+        unsubscribe: () => {
+          set?.delete(cb);
+        },
+      };
+    },
+
+    async listOutbox() {
+      return idbListOutbox();
+    },
+
+    async pushOutbox(m) {
+      await idbPutOutbox(m);
+      await refreshOutboxCount();
+    },
+
+    async removeOutbox(id) {
+      await idbDeleteOutbox(id);
+      await refreshOutboxCount();
+    },
+
+    async getGoogleLink() {
+      return (
+        (await idbGetMeta<GoogleCalendarLink>(LINK_KEY)) ?? {
+          connected: false,
+          status: 'idle',
+          lastSyncAt: null,
+          mode: 'two-way',
+          scopesGranted: [],
+          message: 'Google Calendar sync requires a cloud backend.',
+        }
+      );
+    },
+
+    async saveGoogleLink(_userId, link) {
+      await idbPutMeta(LINK_KEY, link);
+    },
+
+    getStatus() {
+      return status;
+    },
+
+    onStatusChange(cb) {
+      statusListeners.add(cb);
+      return { unsubscribe: () => statusListeners.delete(cb) };
+    },
+
+    async flush() {
+      // Everything already lives on-device; nothing to push.
+      setStatus({ state: 'idle', pending: 0, lastSyncedAt: new Date().toISOString() });
+      return 0;
+    },
+  };
+}
diff --git a/src/lib/providers/supabase.ts b/src/lib/providers/supabase.ts
new file mode 100644
index 0000000..6de4284
--- /dev/null
+++ b/src/lib/providers/supabase.ts
@@ -0,0 +1,729 @@
+/**
+ * Supabase cloud provider.
+ *
+ * Activated when `VITE_SUPABASE_URL` + `VITE_SUPABASE_ANON_KEY` are present.
+ * Gives you:
+ *   • Google OAuth (Supabase Auth → Google provider, PKCE flow)
+ *   • Postgres storage with Row Level Security on every table
+ *   • Realtime `postgres_changes` subscriptions → true cross-device sync
+ *   • An IndexedDB mirror so the calendar still renders offline, with an
+ *     outbox that replays writes when the connection returns.
+ *
+ * Security notes:
+ *   – The anon key is a *publishable* key; authorisation is enforced by RLS
+ *     (`supabase/migrations/0001_init.sql`), never by key secrecy.
+ *   – Access/refresh tokens are handled by supabase-js and kept in memory +
+ *     its own storage. We never write a Google password or raw OAuth token
+ *     into our tables.
+ */
+import { createClient, type RealtimeChannel, type SupabaseClient } from '@supabase/supabase-js';
+import {
+  DEFAULT_SETTINGS,
+  type CalEvent,
+  type ChatMessage,
+  type DataStatus,
+  type GoogleCalendarLink,
+  type PendingMutation,
+  type UserProfile,
+  type UserSettings,
+} from '../../types';
+import { newId } from '../utils';
+import {
+  idbDeleteOutbox,
+  idbListEvents,
+  idbListOutbox,
+  idbPutEvent,
+  idbPutEvents,
+  idbPutOutbox,
+  idbPutSettings,
+  idbGetSettings,
+  idbListChat,
+  idbPutChat,
+  idbClearChat,
+} from './idb';
+import type { AuthSession, DataProvider } from './types';
+import { chatFromRow, chatToRow, eventFromRow, eventToRow, mergeEvent } from './types';
+
+type Listener<T> = (v: T) => void;
+
+function emit<T>(set: Set<Listener<T>>, value: T) {
+  set.forEach((fn) => {
+    try {
+      fn(value);
+    } catch (err) {
+      console.error('[planify:cloud] listener threw', err);
+    }
+  });
+}
+
+export function supabaseEnv(): { url: string; anonKey: string } | null {
+  const url = (import.meta.env.VITE_SUPABASE_URL ?? '').trim();
+  const anonKey = (import.meta.env.VITE_SUPABASE_ANON_KEY ?? '').trim();
+  if (!url || !anonKey) return null;
+  if (!/^https:\/\/.+/i.test(url)) return null;
+  return { url, anonKey };
+}
+
+export function createCloudProvider(url: string, anonKey: string): DataProvider {
+  const supabase: SupabaseClient = createClient(url, anonKey, {
+    auth: {
+      persistSession: true,
+      autoRefreshToken: true,
+      detectSessionInUrl: true,
+      flowType: 'pkce',
+      storageKey: 'planify:sb',
+    },
+    realtime: { params: { eventsPerSecond: 8 } },
+  });
+
+  let status: DataStatus = {
+    state: 'idle',
+    pending: 0,
+    lastSyncedAt: null,
+    message: null,
+    mode: 'cloud',
+  };
+
+  const statusListeners = new Set<Listener<DataStatus>>();
+  const authListeners = new Set<Listener<AuthSession | null>>();
+  const eventListeners = new Map<string, Set<Listener<CalEvent[]>>>();
+  const settingsListeners = new Map<string, Set<Listener<UserSettings>>>();
+  const chatListeners = new Map<string, Set<Listener<ChatMessage[]>>>();
+  const channels = new Map<string, RealtimeChannel>();
+
+  function setStatus(patch: Partial<DataStatus>) {
+    status = { ...status, ...patch };
+    emit(statusListeners, status);
+  }
+
+  function online(): boolean {
+    return typeof navigator === 'undefined' ? true : navigator.onLine;
+  }
+
+  async function profileFromSession(
+    userId: string,
+    email: string | undefined,
+    meta: Record<string, unknown> | undefined,
+  ): Promise<UserProfile> {
+    const now = new Date().toISOString();
+    // Upsert the profile row so account deletion and settings have a home.
+    const name =
+      ((meta?.full_name as string) ||
+        (meta?.name as string) ||
+        (email ? email.split('@')[0] : '') ||
+        'Planify user').trim();
+    const avatar =
+      (meta?.avatar_url as string) ||
+      (meta?.picture as string) ||
+      null;
+
+    const { error } = await supabase
+      .from('profiles')
+      .upsert(
+        {
+          id: userId,
+          email: email ?? '',
+          name,
+          avatar_url: avatar,
+          provider: 'google',
+          last_seen_at: now,
+        },
+        { onConflict: 'id' },
+      )
+      .select('*')
+      .single();
+
+    if (error && error.code !== '23505') {
+      console.warn('[planify:cloud] profile upsert failed', error.message);
+    }
+
+    const { data: row } = await supabase.from('profiles').select('*').eq('id', userId).single();
+
+    return {
+      id: userId,
+      email: row?.email ?? email ?? '',
+      name: row?.name ?? name,
+      avatarUrl: row?.avatar_url ?? avatar,
+      provider: (row?.provider as UserProfile['provider']) ?? 'google',
+      createdAt: row?.created_at ?? now,
+      lastSeenAt: row?.last_seen_at ?? now,
+      onboardingComplete: !!row?.onboarding_complete,
+    };
+  }
+
+  async function toSession(): Promise<AuthSession | null> {
+    const { data } = await supabase.auth.getSession();
+    const s = data.session;
+    if (!s?.user) return null;
+    const profile = await profileFromSession(
+      s.user.id,
+      s.user.email,
+      (s.user.user_metadata ?? {}) as Record<string, unknown>,
+    );
+    return { user: profile, accessToken: s.access_token };
+  }
+
+  /** Queue a write for later when we are offline or the request failed. */
+  async function enqueue(m: Omit<PendingMutation, 'id' | 'createdAt' | 'attempts'>) {
+    const mutation: PendingMutation = {
+      ...m,
+      id: newId('mut'),
+      createdAt: new Date().toISOString(),
+      attempts: 0,
+    };
+    await idbPutOutbox(mutation);
+    setStatus({ state: 'offline', pending: (await idbListOutbox()).length });
+  }
+
+  function subscribeRealtime(userId: string) {
+    const key = `events:${userId}`;
+    if (channels.has(key)) return;
+    const channel = supabase
+      .channel(key, { config: { broadcast: { self: false } } })
+      .on(
+        'postgres_changes',
+        { event: '*', schema: 'public', table: 'events', filter: `user_id=eq.${userId}` },
+        async () => {
+          const { data, error } = await supabase
+            .from('events')
+            .select('*')
+            .eq('user_id', userId)
+            .order('start_time', { ascending: true });
+          if (error) {
+            setStatus({ state: 'error', message: error.message });
+            return;
+          }
+          const events = (data ?? []).map(eventFromRow);
+          // Mirror to IndexedDB so an offline reload still has the calendar.
+          await idbPutEvents(events).catch(() => undefined);
+          emit(eventListeners.get(userId) ?? new Set<Listener<CalEvent[]>>(), events);
+          setStatus({ state: 'idle', lastSyncedAt: new Date().toISOString(), message: null });
+        },
+      )
+      .on(
+        'postgres_changes',
+        { event: '*', schema: 'public', table: 'user_settings', filter: `user_id=eq.${userId}` },
+        async (payload) => {
+          const row = (payload.new ?? payload.old) as Record<string, unknown> | undefined;
+          if (!row) return;
+          const s: UserSettings = {
+            ...DEFAULT_SETTINGS,
+            themeMode: (row.theme_mode as UserSettings['themeMode']) ?? DEFAULT_SETTINGS.themeMode,
+            firstDayOfWeek: ((row.first_day_of_week as number) ?? DEFAULT_SETTINGS.firstDayOfWeek) as UserSettings['firstDayOfWeek'],
+            timeFormat: (row.time_format as UserSettings['timeFormat']) ?? DEFAULT_SETTINGS.timeFormat,
+            defaultReminderMinutes: (row.default_reminder_minutes as number) ?? DEFAULT_SETTINGS.defaultReminderMinutes,
+            timezone: (row.timezone as string) ?? DEFAULT_SETTINGS.timezone,
+            dayStartHour: (row.day_start_hour as number) ?? DEFAULT_SETTINGS.dayStartHour,
+            weekViewDays: (row.week_view_days as 5 | 7) ?? DEFAULT_SETTINGS.weekViewDays,
+            defaultCategoryId: (row.default_category_id as string) ?? DEFAULT_SETTINGS.defaultCategoryId,
+            reduceMotion: !!row.reduce_motion,
+            notificationsEnabled: !!row.notifications_enabled,
+            accentHue: (row.accent_hue as number) ?? DEFAULT_SETTINGS.accentHue,
+          };
+          await idbPutSettings(userId, s).catch(() => undefined);
+          emit(settingsListeners.get(userId) ?? new Set<Listener<UserSettings>>(), s);
+        },
+      )
+      .on(
+        'postgres_changes',
+        { event: '*', schema: 'public', table: 'chat_messages', filter: `user_id=eq.${userId}` },
+        async () => {
+          const { data } = await supabase
+            .from('chat_messages')
+            .select('*')
+            .eq('user_id', userId)
+            .order('created_at', { ascending: true });
+          const msgs = (data ?? []).map(chatFromRow);
+          emit(chatListeners.get(userId) ?? new Set<Listener<ChatMessage[]>>(), msgs);
+        },
+      )
+      .subscribe();
+    channels.set(key, channel);
+  }
+
+  async function flushOutbox(): Promise<number> {
+    const queue = await idbListOutbox();
+    if (!queue.length) {
+      setStatus({ state: 'idle', pending: 0 });
+      return 0;
+    }
+    if (!online()) {
+      setStatus({ state: 'offline', pending: queue.length });
+      return 0;
+    }
+    setStatus({ state: 'syncing', pending: queue.length });
+    let applied = 0;
+
+    for (const m of queue.sort((a, b) => (a.createdAt < b.createdAt ? -1 : 1))) {
+      try {
+        if (m.entity === 'event') {
+          if (m.op === 'delete') {
+            const { error } = await supabase
+              .from('events')
+              .update({ deleted: true, updated_at: new Date().toISOString(), version: 999_999 })
+              .eq('id', (m.payload as CalEvent).id);
+            if (error) throw error;
+          } else {
+            const { error } = await supabase
+              .from('events')
+              .upsert(eventToRow(m.payload as CalEvent), { onConflict: 'id' });
+            if (error) throw error;
+          }
+        } else if (m.entity === 'settings') {
+          const s = m.payload as UserSettings & { userId?: string };
+          const userId = s.userId ?? m.userId;
+          const { error } = await supabase
+            .from('user_settings')
+            .upsert(
+              {
+                user_id: userId,
+                theme_mode: s.themeMode,
+                first_day_of_week: s.firstDayOfWeek,
+                time_format: s.timeFormat,
+                default_reminder_minutes: s.defaultReminderMinutes,
+                timezone: s.timezone,
+                day_start_hour: s.dayStartHour,
+                week_view_days: s.weekViewDays,
+                default_category_id: s.defaultCategoryId,
+                reduce_motion: s.reduceMotion,
+                notifications_enabled: s.notificationsEnabled,
+                accent_hue: s.accentHue,
+              },
+              { onConflict: 'user_id' },
+            );
+          if (error) throw error;
+        } else if (m.entity === 'chat') {
+          const { error } = await supabase
+            .from('chat_messages')
+            .upsert(chatToRow(m.payload as ChatMessage), { onConflict: 'id' });
+          if (error) throw error;
+        }
+        await idbDeleteOutbox(m.id);
+        applied += 1;
+      } catch (err) {
+        const msg = err instanceof Error ? err.message : String(err);
+        setStatus({ state: 'error', message: msg });
+        // Stop at the first failure to preserve ordering.
+        break;
+      }
+    }
+
+    const remaining = await idbListOutbox();
+    setStatus({
+      state: remaining.length ? 'error' : 'idle',
+      pending: remaining.length,
+      lastSyncedAt: applied ? new Date().toISOString() : status.lastSyncedAt,
+    });
+    return applied;
+  }
+
+  window.addEventListener('online', () => {
+    void flushOutbox();
+  });
+  window.addEventListener('offline', () => {
+    setStatus({ state: 'offline', message: 'You are offline. Changes are saved on this device and will sync automatically.' });
+  });
+
+  return {
+    id: 'cloud',
+    label: 'Planify Cloud',
+    description:
+      'Your calendar is stored in your own Supabase Postgres database, protected by Row Level Security, and synced in realtime to every device you sign in on.',
+
+    async init() {
+      supabase.auth.onAuthStateChange((event, s) => {
+        if (event === 'SIGNED_IN' && s?.user) {
+          void toSession().then((sess) => {
+            emit(authListeners, sess);
+            if (sess?.user) subscribeRealtime(sess.user.id);
+          });
+        } else if (event === 'SIGNED_OUT') {
+          channels.forEach((c) => void supabase.removeChannel(c));
+          channels.clear();
+          emit(authListeners, null);
+        } else if (event === 'TOKEN_REFRESHED') {
+          void toSession().then((sess) => emit(authListeners, sess));
+        }
+      });
+      const sess = await toSession();
+      if (sess?.user) subscribeRealtime(sess.user.id);
+      await flushOutbox();
+    },
+
+    async getSession() {
+      return toSession();
+    },
+
+    onAuthChange(cb) {
+      authListeners.add(cb);
+      return { unsubscribe: () => authListeners.delete(cb) };
+    },
+
+    async signInWithGoogle() {
+      const { error } = await supabase.auth.signInWithOAuth({
+        provider: 'google',
+        options: {
+          // Minimum scope: identity only. Calendar scope is requested later and
+          // separately, only if the user opts in to Google Calendar sync.
+          scopes: 'openid email profile',
+          redirectTo: `${window.location.origin}${window.location.pathname}`,
+          skipBrowserRedirect: false,
+        },
+      });
+      if (error) return { ok: false, error: error.message };
+      return { ok: true };
+    },
+
+    async signInLocally() {
+      // Cloud mode authenticates through Google. Returning null is honest:
+      // there is no local account concept once a cloud project is attached.
+      console.warn(
+        '[planify] cloud mode uses Google sign-in; remove the Supabase env vars to use an on-device account.',
+      );
+      return null;
+    },
+
+    async signOut() {
+      await supabase.auth.signOut();
+      channels.forEach((c) => void supabase.removeChannel(c));
+      channels.clear();
+      emit(authListeners, null);
+    },
+
+    async updateProfile(patch) {
+      const { data } = await supabase.auth.getSession();
