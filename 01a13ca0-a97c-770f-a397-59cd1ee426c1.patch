new file mode 100644
index 0000000..296d17e
--- /dev/null
+++ b/src/hooks/useCalendarShell.ts
@@ -0,0 +1,175 @@
+/**
+ * Calendar shell state: which view, which anchor date, search/filter, selection
+ * and the sheets that float over the grid.
+ */
+import { useCallback, useEffect, useMemo, useState } from 'react';
+import { dayKey, fromDayKey, isSameDay, shiftAnchor, startOfDay } from '../lib/dates';
+import { applyFilters, EMPTY_FILTERS, occurrencesFor, resolveRange, type EventFilters, type ViewRange } from '../lib/calendarEngine';
+import { useAppStore } from '../store/AppStore';
+import type { CalEvent, CalendarViewMode, Occurrence, UserSettings, Weekday } from '../types';
+
+export interface EditorTarget {
+  /** Existing event being edited, or null for a new one. */
+  event: CalEvent | null;
+  /** Pre-filled draft values for a new event. */
+  draft?: Partial<CalEvent>;
+  /** When editing a recurring series, which occurrence the user tapped. */
+  occurrence?: Occurrence | null;
+}
+
+export interface CalendarShell {
+  view: CalendarViewMode;
+  setView: (v: CalendarViewMode) => void;
+  anchor: Date;
+  setAnchor: (d: Date) => void;
+  goToday: () => void;
+  step: (delta: number) => void;
+  selectedDay: Date;
+  selectDay: (d: Date) => void;
+  range: ViewRange;
+  visibleEvents: CalEvent[];
+  occurrences: Occurrence[];
+  filters: EventFilters;
+  setFilters: React.Dispatch<React.SetStateAction<EventFilters>>;
+  clearFilters: () => void;
+  searchOpen: boolean;
+  setSearchOpen: (v: boolean) => void;
+  editor: EditorTarget | null;
+  openEditor: (t: EditorTarget) => void;
+  closeEditor: () => void;
+  detail: Occurrence | null;
+  openDetail: (o: Occurrence) => void;
+  closeDetail: () => void;
+  aiOpen: boolean;
+  setAiOpen: (v: boolean) => void;
+  settings: UserSettings;
+}
+
+const VIEW_STORAGE_KEY = 'planify:view';
+
+export function useCalendarShell(settings: UserSettings): CalendarShell {
+  const { events } = useAppStore();
+
+  const [view, setViewState] = useState<CalendarViewMode>(() => {
+    try {
+      const saved = localStorage.getItem(VIEW_STORAGE_KEY) as CalendarViewMode | null;
+      if (saved && ['month', 'week', 'day', 'agenda'].includes(saved)) return saved;
+    } catch {
+      /* ignore */
+    }
+    // Phones default to a list of what's coming; wide screens to the month.
+    return typeof window !== 'undefined' && window.innerWidth < 768 ? 'agenda' : 'month';
+  });
+
+  const [anchor, setAnchor] = useState<Date>(() => startOfDay(new Date()));
+  const [selectedDay, setSelectedDay] = useState<Date>(() => startOfDay(new Date()));
+  const [filters, setFilters] = useState<EventFilters>(EMPTY_FILTERS);
+  const [searchOpen, setSearchOpen] = useState(false);
+  const [editor, setEditor] = useState<EditorTarget | null>(null);
+  const [detail, setDetail] = useState<Occurrence | null>(null);
+  const [aiOpen, setAiOpen] = useState(false);
+
+  const setView = useCallback((v: CalendarViewMode) => {
+    setViewState(v);
+    try {
+      localStorage.setItem(VIEW_STORAGE_KEY, v);
+    } catch {
+      /* ignore */
+    }
+  }, []);
+
+  const goToday = useCallback(() => {
+    const today = startOfDay(new Date());
+    setAnchor(today);
+    setSelectedDay(today);
+  }, []);
+
+  const step = useCallback(
+    (delta: number) => {
+      setAnchor((prev) => {
+        const next = shiftAnchor(prev, view === 'agenda' ? 'month' : view, delta);
+        setSelectedDay(next);
+        return next;
+      });
+    },
+    [view],
+  );
+
+  const selectDay = useCallback((d: Date) => {
+    const day = startOfDay(d);
+    setSelectedDay(day);
+    setAnchor(day);
+  }, []);
+
+  const range = useMemo(
+    () =>
+      resolveRange(
+        view,
+        anchor,
+        settings.firstDayOfWeek as Weekday,
+        settings.weekViewDays,
+      ),
+    [view, anchor, settings.firstDayOfWeek, settings.weekViewDays],
+  );
+
+  const visibleEvents = useMemo(
+    () => applyFilters(events, filters),
+    [events, filters],
+  );
+
+  const occurrences = useMemo(
+    () => occurrencesFor(visibleEvents, range),
+    [visibleEvents, range],
+  );
+
+  // Keep the anchor on the same month/week when the view changes so the
+  // transition feels continuous rather than jumping back to today.
+  useEffect(() => {
+    if (view === 'day' && !isSameDay(anchor, selectedDay)) {
+      setAnchor(selectedDay);
+    }
+  }, [view, anchor, selectedDay]);
+
+  const openEditor = useCallback((t: EditorTarget) => {
+    setDetail(null);
+    setEditor(t);
+  }, []);
+  const closeEditor = useCallback(() => setEditor(null), []);
+  const openDetail = useCallback((o: Occurrence) => {
+    setEditor(null);
+    setDetail(o);
+  }, []);
+  const closeDetail = useCallback(() => setDetail(null), []);
+
+  const clearFilters = useCallback(() => setFilters(EMPTY_FILTERS), []);
+
+  return {
+    view,
+    setView,
+    anchor,
+    setAnchor,
+    goToday,
+    step,
+    selectedDay,
+    selectDay,
+    range,
+    visibleEvents,
+    occurrences,
+    filters,
+    setFilters,
+    clearFilters,
+    searchOpen,
+    setSearchOpen,
+    editor,
+    openEditor,
+    closeEditor,
+    detail,
+    openDetail,
+    closeDetail,
+    aiOpen,
+    setAiOpen,
+    settings,
+  };
+}
+
+export { dayKey, fromDayKey };
diff --git a/src/hooks/useDrag.ts b/src/hooks/useDrag.ts
new file mode 100644
index 0000000..144e6f5
--- /dev/null
+++ b/src/hooks/useDrag.ts
@@ -0,0 +1,259 @@
+/**
+ * Drag-and-drop rescheduling.
+ *
+ * Pointer-event based rather than HTML5 drag-and-drop, because HTML5 DnD does
+ * not work on touch. One implementation therefore covers trackpad, mouse and
+ * finger, on iPhone, iPad and Android alike.
+ *
+ * Behaviour:
+ *   • Time grid (day/week): pointerdown on an event → after a short hold on
+ *     touch (or immediately with a mouse) the card lifts and follows the
+ *     pointer vertically, snapping to 15 minutes. Horizontal movement across
+ *     columns changes the day.
+ *   • Month grid: dragging moves the event to the day under the pointer.
+ *   • A tap (movement below the threshold, released quickly) is NOT a drag — it
+ *     opens the event, which keeps normal clicking/tapping intact.
+ */
+import { useCallback, useEffect, useRef, useState } from 'react';
+
+export interface DragState {
+  /** Unique occurrence id being dragged. */
+  occurrenceId: string;
+  seriesId: string;
+  /** Pixel offset from the pointer to the card's top-left, for smooth follow. */
+  offsetX: number;
+  offsetY: number;
+  /** Current pointer position in viewport coordinates. */
+  pointerX: number;
+  pointerY: number;
+  /** Minutes the event has moved by (time grid). */
+  deltaMinutes: number;
+  /** Day key the pointer is currently over (month grid, and time-grid columns). */
+  overDayKey: string | null;
+  /** True once the gesture has passed the drag threshold. */
+  active: boolean;
+  /** True while the pointer is held but the threshold is not yet crossed. */
+  pending: boolean;
+}
+
+export interface DragResult {
+  occurrenceId: string;
+  seriesId: string;
+  deltaMinutes: number;
+  overDayKey: string | null;
+}
+
+export interface UseDragOptions {
+  /** Minutes of vertical travel per pixel — set by the caller from row height. */
+  minutesPerPixel: number;
+  /** Snap increment in minutes. */
+  snapMinutes?: number;
+  /** Long-press delay before a touch drag begins. */
+  holdMs?: number;
+  /** Movement in px before a mouse drag begins. */
+  thresholdPx?: number;
+  onCommit: (result: DragResult) => void;
+  onCancel?: () => void;
+}
+
+const TOUCH_HOLD_MS = 170;
+const THRESHOLD_PX = 5;
+
+export function useDrag({
+  minutesPerPixel,
+  snapMinutes = 15,
+  holdMs = TOUCH_HOLD_MS,
+  thresholdPx = THRESHOLD_PX,
+  onCommit,
+  onCancel,
+}: UseDragOptions) {
+  const [drag, setDrag] = useState<DragState | null>(null);
+  const stateRef = useRef<{
+    pointerId: number;
+    startX: number;
+    startY: number;
+    offsetY: number;
+    offsetX: number;
+    occurrenceId: string;
+    seriesId: string;
+    isTouch: boolean;
+    holdTimer: number | null;
+    active: boolean;
+    lastDelta: number;
+    lastDayKey: string | null;
+  } | null>(null);
+
+  const cleanup = useCallback(() => {
+    const s = stateRef.current;
+    if (s?.holdTimer) window.clearTimeout(s.holdTimer);
+    stateRef.current = null;
+    document.body.style.removeProperty('user-select');
+    document.body.style.removeProperty('-webkit-user-select');
+    document.body.style.removeProperty('cursor');
+  }, []);
+
+  const begin = useCallback(
+    (e: React.PointerEvent<HTMLElement>, occurrenceId: string, seriesId: string) => {
+      // Only the primary button; let right-click open the context menu.
+      if (e.button !== undefined && e.button !== 0) return;
+      const target = e.currentTarget as HTMLElement;
+      const rect = target.getBoundingClientRect();
+      const isTouch = e.pointerType === 'touch' || e.pointerType === 'pen';
+
+      const base = {
+        pointerId: e.pointerId,
+        startX: e.clientX,
+        startY: e.clientY,
+        offsetX: e.clientX - rect.left,
+        offsetY: e.clientY - rect.top,
+        occurrenceId,
+        seriesId,
+        isTouch,
+        holdTimer: null as number | null,
+        active: false,
+        lastDelta: 0,
+        lastDayKey: null as string | null,
+      };
+
+      const publish = (active: boolean, pending: boolean, x = base.startX, y = base.startY) => {
+        setDrag({
+          occurrenceId,
+          seriesId,
+          offsetX: base.offsetX,
+          offsetY: base.offsetY,
+          pointerX: x,
+          pointerY: y,
+          deltaMinutes: base.lastDelta,
+          overDayKey: base.lastDayKey,
+          active,
+          pending,
+        });
+      };
+
+      if (isTouch) {
+        stateRef.current = base;
+        publish(false, true);
+        // Long-press to drag; a quick lift stays a tap so opening events on
+        // touch still works naturally.
+        base.holdTimer = window.setTimeout(() => {
+          const s = stateRef.current;
+          if (!s) return;
+          s.active = true;
+          publish(true, false);
+          if (navigator.vibrate) navigator.vibrate(10);
+        }, holdMs);
+        return;
+      }
+
+      base.active = false;
+      stateRef.current = base;
+      publish(false, true);
+    },
+    [holdMs],
+  );
+
+  useEffect(() => {
+    if (!drag) return;
+
+    const move = (e: PointerEvent) => {
+      const s = stateRef.current;
+      if (!s || e.pointerId !== s.pointerId) return;
+
+      const dx = e.clientX - s.startX;
+      const dy = e.clientY - s.startY;
+
+      if (!s.active) {
+        if (s.isTouch) {
+          // Any real movement cancels the pending long-press → it becomes a tap.
+          if (Math.hypot(dx, dy) > 10) {
+            if (s.holdTimer) window.clearTimeout(s.holdTimer);
+            s.holdTimer = null;
+            stateRef.current = null;
+            setDrag(null);
+          }
+          return;
+        }
+        if (Math.hypot(dx, dy) < thresholdPx) return;
+        s.active = true;
+        document.body.style.userSelect = 'none';
+        document.body.style.setProperty('-webkit-user-select', 'none');
+        document.body.style.cursor = 'grabbing';
+      }
+
+      e.preventDefault();
+
+      // Which day column is under the pointer? Elements opt in with
+      // data-daykey, so this works for both month and time grids.
+      const under = document.elementFromPoint(e.clientX, e.clientY);
+      const cell = under?.closest?.('[data-daykey]') as HTMLElement | null;
+      s.lastDayKey = cell?.dataset.daykey ?? s.lastDayKey;
+
+      const rawMinutes = dy * minutesPerPixel;
+      const snapped = Math.round(rawMinutes / snapMinutes) * snapMinutes;
+      s.lastDelta = snapped;
+
+      setDrag((prev) =>
+        prev
+          ? {
+              ...prev,
+              pointerX: e.clientX,
+              pointerY: e.clientY,
+              deltaMinutes: snapped,
+              overDayKey: s.lastDayKey,
+              active: true,
+              pending: false,
+            }
+          : prev,
+      );
+    };
+
+    const up = (e: PointerEvent) => {
+      const s = stateRef.current;
+      if (!s || e.pointerId !== s.pointerId) return;
+      const wasActive = s.active;
+      if (s.holdTimer) window.clearTimeout(s.holdTimer);
+
+      if (wasActive) {
+        const under = document.elementFromPoint(e.clientX, e.clientY);
+        const cell = under?.closest?.('[data-daykey]') as HTMLElement | null;
+        onCommit({
+          occurrenceId: s.occurrenceId,
+          seriesId: s.seriesId,
+          deltaMinutes: s.lastDelta,
+          overDayKey: cell?.dataset.daykey ?? s.lastDayKey,
+        });
+      } else {
+        onCancel?.();
+      }
+      cleanup();
+      setDrag(null);
+    };
+
+    const cancel = () => {
+      onCancel?.();
+      cleanup();
+      setDrag(null);
+    };
+
+    window.addEventListener('pointermove', move, { passive: false });
+    window.addEventListener('pointerup', up);
+    window.addEventListener('pointercancel', cancel);
+    window.addEventListener('blur', cancel);
+    return () => {
+      window.removeEventListener('pointermove', move);
+      window.removeEventListener('pointerup', up);
+      window.removeEventListener('pointercancel', cancel);
+      window.removeEventListener('blur', cancel);
+    };
+  }, [drag, minutesPerPixel, snapMinutes, thresholdPx, onCommit, onCancel, cleanup]);
+
+  return { drag, beginDrag: begin };
+}
+
+/**
+ * Attach a `data-daykey` to a droppable region. Kept as a helper so the
+ * convention is defined in exactly one place.
+ */
+export function droppable(dayKey: string) {
+  return { 'data-daykey': dayKey } as const;
+}
diff --git a/src/hooks/useTheme.ts b/src/hooks/useTheme.ts
new file mode 100644
index 0000000..49f93ac
--- /dev/null
+++ b/src/hooks/useTheme.ts
@@ -0,0 +1,47 @@
+/**
+ * Theme.
+ *
+ * `dark` is the default. `system` follows the device appearance setting and
+ * reacts live to OS-level changes. The resolved value is written to
+ * `<html data-theme>` so the whole palette swaps through CSS variables, and the
+ * colour transitions declared in `theme.css` animate the change.
+ */
+import { createContext, useContext } from 'react';
+import type { ResolvedTheme, ThemeMode } from '../types';
+
+export interface ThemeContextValue {
+  mode: ThemeMode;
+  resolved: ResolvedTheme;
+  setMode(mode: ThemeMode): void;
+  cycle(): void;
+}
+
+export const ThemeContext = createContext<ThemeContextValue>({
+  mode: 'dark',
+  resolved: 'dark',
+  setMode: () => undefined,
+  cycle: () => undefined,
+});
+
+export function useTheme(): ThemeContextValue {
+  return useContext(ThemeContext);
+}
+
+export function prefersDark(): boolean {
+  return typeof window !== 'undefined' && window.matchMedia('(prefers-color-scheme: dark)').matches;
+}
+
+export function resolveTheme(mode: ThemeMode): ResolvedTheme {
+  if (mode === 'system') return prefersDark() ? 'dark' : 'light';
+  return mode;
+}
+
+export function applyThemeToDocument(resolved: ResolvedTheme): void {
+  const root = document.documentElement;
+  root.setAttribute('data-theme', resolved);
+  // Keep the browser chrome (iOS status bar, Android address bar) in step.
+  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]:not([media])');
+  const colour = resolved === 'dark' ? '#0A0A0C' : '#F4F4F7';
+  if (meta) meta.setAttribute('content', colour);
+  root.style.colorScheme = resolved;
+}
diff --git a/src/hooks/useViewport.ts b/src/hooks/useViewport.ts
new file mode 100644
index 0000000..45485fd
--- /dev/null
+++ b/src/hooks/useViewport.ts
@@ -0,0 +1,241 @@
+import { useEffect, useRef, useState } from 'react';
+import { LOCAL_TZ } from '../lib/dates';
+
+export type Breakpoint = 'mobile' | 'tablet' | 'laptop' | 'desktop';
+
+export interface Viewport {
+  width: number;
+  height: number;
+  breakpoint: Breakpoint;
+  isMobile: boolean;
+  isTablet: boolean;
+  isDesktop: boolean;
+  /** True when the pointer is coarse (touch) regardless of width. */
+  isTouch: boolean;
+  /** Short viewport: iPhone landscape, small Android windows. */
+  isShort: boolean;
+  safeTop: number;
+  safeBottom: number;
+}
+
+const MOBILE_MAX = 767;
+const TABLET_MAX = 1023;
+const LAPTOP_MAX = 1439;
+
+function readSafeArea(): { top: number; bottom: number } {
+  if (typeof getComputedStyle === 'undefined') return { top: 0, bottom: 0 };
+  const probe = document.documentElement;
+  const cs = getComputedStyle(probe);
+  const parse = (v: string) => {
+    const n = Number.parseFloat(v);
+    return Number.isFinite(n) ? n : 0;
+  };
+  return {
+    top: parse(cs.getPropertyValue('--sat') || '0px'),
+    bottom: parse(cs.getPropertyValue('--sab') || '0px'),
+  };
+}
+
+function compute(): Viewport {
+  const width = typeof window === 'undefined' ? 1280 : window.innerWidth;
+  const height = typeof window === 'undefined' ? 800 : window.innerHeight;
+  const breakpoint: Breakpoint =
+    width <= MOBILE_MAX ? 'mobile' : width <= TABLET_MAX ? 'tablet' : width <= LAPTOP_MAX ? 'laptop' : 'desktop';
+  const { top, bottom } = readSafeArea();
+  return {
+    width,
+    height,
+    breakpoint,
+    isMobile: breakpoint === 'mobile',
+    isTablet: breakpoint === 'tablet',
+    isDesktop: breakpoint === 'laptop' || breakpoint === 'desktop',
+    isTouch:
+      typeof window !== 'undefined' &&
+      (window.matchMedia('(pointer: coarse)').matches || navigator.maxTouchPoints > 0),
+    isShort: height < 560,
+    safeTop: top,
+    safeBottom: bottom,
+  };
+}
+
+/**
+ * Viewport metrics, updated on resize/orientation change.
+ *
+ * Uses `matchMedia` for the breakpoint decision so a resize that does not cross
+ * a breakpoint does not re-render the whole tree, and rAF-throttles the raw
+ * size updates that the time-grid layout needs.
+ */
+export function useViewport(): Viewport {
+  const [vp, setVp] = useState<Viewport>(compute);
+
+  useEffect(() => {
+    let frame = 0;
+    const update = () => {
+      if (frame) return;
+      frame = requestAnimationFrame(() => {
+        frame = 0;
+        setVp(compute());
+      });
+    };
+    window.addEventListener('resize', update);
+    window.addEventListener('orientationchange', update);
+    const mq = window.matchMedia('(pointer: coarse)');
+    mq.addEventListener?.('change', update);
+    return () => {
+      window.removeEventListener('resize', update);
+      window.removeEventListener('orientationchange', update);
+      mq.removeEventListener?.('change', update);
+      if (frame) cancelAnimationFrame(frame);
+    };
+  }, []);
+
+  return vp;
+}
+
+/** True when the browser tab is visible — used to re-sync on return. */
+export function usePageVisible(): boolean {
+  const [visible, setVisible] = useState(() =>
+    typeof document === 'undefined' ? true : document.visibilityState === 'visible',
+  );
+  useEffect(() => {
+    const onChange = () => setVisible(document.visibilityState === 'visible');
+    document.addEventListener('visibilitychange', onChange);
+    return () => document.removeEventListener('visibilitychange', onChange);
+  }, []);
+  return visible;
+}
+
+export function useOnline(): boolean {
+  const [online, setOnline] = useState(() => (typeof navigator === 'undefined' ? true : navigator.onLine));
+  useEffect(() => {
+    const up = () => setOnline(true);
+    const down = () => setOnline(false);
+    window.addEventListener('online', up);
+    window.addEventListener('offline', down);
+    return () => {
+      window.removeEventListener('online', up);
+      window.removeEventListener('offline', down);
+    };
+  }, []);
+  return online;
+}
+
+/** The user's IANA timezone, kept reactive to system changes. */
+export function useTimezone(): string {
+  const [tz, setTz] = useState<string>(LOCAL_TZ);
+  useEffect(() => {
+    const id = setInterval(() => {
+      const current = Intl.DateTimeFormat().resolvedOptions().timeZone;
+      setTz((prev) => (prev === current ? prev : current));
+    }, 60_000);
+    return () => clearInterval(id);
+  }, []);
+  return tz;
+}
+
+/** Ticking clock, aligned to the minute boundary so labels stay correct. */
+export function useNow(intervalMs = 30_000): Date {
+  const [now, setNow] = useState(() => new Date());
+  useEffect(() => {
+    const id = setInterval(() => setNow(new Date()), intervalMs);
+    const onVisible = () => {
+      if (document.visibilityState === 'visible') setNow(new Date());
+    };
+    document.addEventListener('visibilitychange', onVisible);
+    return () => {
+      clearInterval(id);
+      document.removeEventListener('visibilitychange', onVisible);
+    };
+  }, [intervalMs]);
+  return now;
+}
+
+/** Debounced value, for search-as-you-type. */
+export function useDebounced<T>(value: T, ms = 220): T {
+  const [debounced, setDebounced] = useState(value);
+  useEffect(() => {
+    const id = setTimeout(() => setDebounced(value), ms);
+    return () => clearTimeout(id);
+  }, [value, ms]);
+  return debounced;
+}
+
+/** Lock body scroll while a sheet/modal is open, restoring the prior offset. */
+export function useScrollLock(active: boolean): void {
+  useEffect(() => {
+    if (!active) return;
+    const prev = document.body.style.overflow;
+    const prevPad = document.body.style.paddingRight;
+    const scrollbar = window.innerWidth - document.documentElement.clientWidth;
+    document.body.style.overflow = 'hidden';
+    if (scrollbar > 0) document.body.style.paddingRight = `${scrollbar}px`;
+    return () => {
+      document.body.style.overflow = prev;
+      document.body.style.paddingRight = prevPad;
+    };
+  }, [active]);
+}
+
+/**
+ * Focus trap + Escape handling for dialogs and sheets.
+ * Returns a ref to attach to the dialog container.
+ */
+export function useDialogBehaviour(
+  open: boolean,
+  onClose: () => void,
+): React.RefObject<HTMLDivElement | null> {
+  const ref = useCallbackRef<HTMLDivElement>();
+
+  useEffect(() => {
+    if (!open) return;
+    const node = ref.current;
+    const previouslyFocused = document.activeElement as HTMLElement | null;
+
+    // Move focus into the dialog: first autofocusable element.
+    const focusables = () =>
+      Array.from(
+        node?.querySelectorAll<HTMLElement>(
+          'a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), [tabindex]:not([tabindex="-1"])',
+        ) ?? [],
+      ).filter((el) => el.offsetParent !== null || el === document.activeElement);
+
+    const initial = node?.querySelector<HTMLElement>('[data-autofocus]') ?? focusables()[0];
+    // A tick lets the enter animation start before focus moves.
+    const t = setTimeout(() => initial?.focus({ preventScroll: true }), 40);
+
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') {
+        e.stopPropagation();
+        onClose();
+        return;
+      }
+      if (e.key !== 'Tab') return;
+      const items = focusables();
+      if (!items.length) return;
+      const first = items[0];
+      const last = items[items.length - 1];
+      const active = document.activeElement as HTMLElement | null;
+      if (e.shiftKey && (active === first || !node?.contains(active))) {
+        e.preventDefault();
+        last.focus();
+      } else if (!e.shiftKey && active === last) {
+        e.preventDefault();
+        first.focus();
+      }
+    };
+
+    document.addEventListener('keydown', onKey, true);
+    return () => {
+      clearTimeout(t);
+      document.removeEventListener('keydown', onKey, true);
+      previouslyFocused?.focus?.({ preventScroll: true });
+    };
+  }, [open, onClose, ref]);
+
+  return ref;
+}
+
+function useCallbackRef<T>() {
+  const ref = useRef<T | null>(null);
+  return ref as React.RefObject<T | null>;
+}
diff --git a/src/lib/calendarEngine.ts b/src/lib/calendarEngine.ts
new file mode 100644
index 0000000..32df97f
--- /dev/null
+++ b/src/lib/calendarEngine.ts
@@ -0,0 +1,409 @@
+/**
+ * Calendar engine: view-range resolution, occurrence lookup, search/filter, and
+ * the column layout algorithm that stops overlapping events from stacking on
+ * top of each other in the time grid.
+ */
+import {
+  addDays,
+  dayKey,
+  differenceInMinutes,
+  endOfMonth,
+  fmtMinutes,
+  formatTime,
+  monthGridDays,
+  startOfDay,
+  startOfMonth,
+  weekDays,
+} from './dates';
+import { bucketByDay, expandAll } from './recurrence';
+import { getCategory, type CalEvent, type CalendarViewMode, type Occurrence } from '../types';
+
+/* -------------------------------------------------------------------------- */
+/* View ranges                                                                 */
+/* -------------------------------------------------------------------------- */
+
+export interface ViewRange {
+  /** First visible day (local, midnight). */
+  start: Date;
+  /** Last visible day (local, midnight). */
+  end: Date;
+  /** Every day cell in the range, in display order. */
+  days: Date[];
+  /** True when the range shows days outside the anchor month. */
+  hasOutsideDays: boolean;
+}
+
+export function resolveRange(
+  view: CalendarViewMode,
+  anchor: Date,
+  firstDayOfWeek: 0 | 1 | 2 | 3 | 4 | 5 | 6,
+  weekCount: 5 | 7 = 7,
+): ViewRange {
+  switch (view) {
+    case 'month': {
+      const days = monthGridDays(anchor, firstDayOfWeek);
+      return {
+        start: days[0],
+        end: days[days.length - 1],
+        days,
+        hasOutsideDays: true,
+      };
+    }
+    case 'week': {
+      const days = weekDays(anchor, firstDayOfWeek, weekCount);
+      return { start: days[0], end: days[days.length - 1], days, hasOutsideDays: false };
+    }
+    case 'day':
+      return {
+        start: startOfDay(anchor),
+        end: startOfDay(anchor),
+        days: [startOfDay(anchor)],
+        hasOutsideDays: false,
+      };
+    case 'agenda': {
+      // 60 days forward from the anchor, or the whole anchor month if that's wider.
+      const start = startOfDay(view === 'agenda' ? anchor : anchor);
+      const end = addDays(start, 59);
+      const days: Date[] = [];
+      for (let d = start; d.getTime() <= end.getTime(); d = addDays(d, 1)) days.push(d);
+      return { start, end, days, hasOutsideDays: false };
+    }
+    default: {
+      const days = monthGridDays(anchor, firstDayOfWeek);
+      return { start: days[0], end: days[days.length - 1], days, hasOutsideDays: false };
+    }
+  }
+}
+
+export function monthLabel(anchor: Date): string {
+  return anchor.toLocaleDateString(undefined, { month: 'long', year: 'numeric' });
+}
+
+/** For agenda we group by month; this gives the ordered month headings. */
+export function monthsInRange(start: Date, end: Date): Date[] {
+  const out: Date[] = [];
+  let cursor = startOfMonth(start);
+  const last = startOfMonth(end);
+  while (cursor.getTime() <= last.getTime()) {
+    out.push(cursor);
+    cursor = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 1);
+  }
+  return out;
+}
+
+export { endOfMonth };
+
+/* -------------------------------------------------------------------------- */
+/* Occurrences                                                                 */
+/* -------------------------------------------------------------------------- */
+
+/**
+ * All occurrences in the visible range, expanded once and reused by every view.
+ * `expandAll` already sorts by start time.
+ */
+export function occurrencesFor(events: CalEvent[], range: ViewRange): Occurrence[] {
+  return expandAll(
+    events.filter((e) => !e.deleted),
+    range.start,
+    range.end,
+  );
+}
+
+export interface DayBucket {
+  /** Occurrences that render in the timed portion of the grid. */
+  timed: Occurrence[];
+  /** Occurrences that render in the all-day strip. */
+  allDay: Occurrence[];
+}
+
+export function bucketForDay(buckets: Map<string, Occurrence[]>, key: string): DayBucket {
+  const list = buckets.get(key) ?? [];
+  return {
+    timed: list.filter((o) => !o.allDay),
+    allDay: list.filter((o) => o.allDay),
+  };
+}
+
+export function bucketsFor(occurrences: Occurrence[]): Map<string, Occurrence[]> {
+  return bucketByDay(occurrences);
+}
+
+/* -------------------------------------------------------------------------- */
+/* Search & filter                                                             */
+/* -------------------------------------------------------------------------- */
+
+export interface EventFilters {
+  query: string;
+  categoryIds: string[];
+  /** 'all' | 'upcoming' | 'today' | 'past' */
+  when: 'all' | 'upcoming' | 'today' | 'past';
+  /** Hide Google-Calendar-imported events. */
+  hideImported: boolean;
+}
+
+export const EMPTY_FILTERS: EventFilters = {
+  query: '',
+  categoryIds: [],
+  when: 'all',
+  hideImported: false,
+};
+
+export function isFilterActive(f: EventFilters): boolean {
+  return (
+    f.query.trim().length > 0 ||
+    f.categoryIds.length > 0 ||
+    f.when !== 'all' ||
+    f.hideImported
+  );
+}
+
+/**
+ * Search across title, location and notes. Dates are matched too, so "march 4"
+ * or "4/3" finds events on that day. Matching is case- and accent-insensitive.
+ */
+export function matchesQuery(event: CalEvent, rawQuery: string, now: Date = new Date()): boolean {
+  const q = normalize(rawQuery);
+  if (!q) return true;
+
+  const hay = normalize(
+    [event.title, event.location, event.description, categoryNameOf(event.categoryId)].join(' \u0001 '),
+  );
+  if (hay.includes(q)) return true;
+
+  // Every word must appear somewhere (AND semantics) — feels more predictable
+  // than OR when searching notes.
+  const words = q.split(/\s+/).filter(Boolean);
+  if (words.length > 1 && words.every((w) => hay.includes(w))) return true;
+
+  // Date matching.
+  const start = event.allDay ? new Date(`${event.startTime.slice(0, 10)}T12:00:00`) : new Date(event.startTime);
+  if (Number.isNaN(start.getTime())) return false;
+
+  const dateStrings = [
+    dayKey(start),
+    start.toLocaleDateString(undefined, { month: 'long', day: 'numeric', year: 'numeric' }),
+    start.toLocaleDateString(undefined, { month: 'short', day: 'numeric' }),
+    start.toLocaleDateString(undefined, { weekday: 'long' }),
+    `${start.getMonth() + 1}/${start.getDate()}`,
+    `${start.getDate()}/${start.getMonth() + 1}`,
+  ].map(normalize);
+
+  if (dateStrings.some((d) => d.includes(q))) return true;
+
+  // Relative phrases people actually type into a search box.
+  const todayKey = dayKey(now);
+  if ((q === 'today' || q === 'todays') && dayKey(start) === todayKey) return true;
+  if ((q === 'tomorrow' || q === 'tmrw') && dayKey(start) === dayKey(addDays(now, 1))) return true;
+  if (/^(this week|week)$/.test(q)) {
+    const diff = Math.abs(differenceInMinutes(start, now)) / 1440;
+    return diff <= 7;
+  }
+  if (/^(repeating|recurring|repeat)$/.test(q)) return !!event.recurrence;
+  if (/^(all day|all-day|allday)$/.test(q)) return event.allDay;
+
+  return false;
+}
+
+function normalize(s: string): string {
+  return s
+    .toLowerCase()
+    .normalize('NFD')
+    .replace(/[\u0300-\u036f]/g, '')
+    .trim();
+}
+
+function categoryNameOf(id: string): string {
+  return getCategory(id).name;
+}
+
+export function applyFilters(
+  events: CalEvent[],
+  filters: EventFilters,
+  now: Date = new Date(),
+): CalEvent[] {
+  const q = filters.query.trim();
+  const todayKey = dayKey(now);
+
+  return events.filter((e) => {
+    if (e.deleted) return false;
+    if (filters.hideImported && e.googleEventId) return false;
+    if (filters.categoryIds.length && !filters.categoryIds.includes(e.categoryId)) return false;
+    if (!matchesQuery(e, q, now)) return false;
+
+    if (filters.when !== 'all') {
+      const start = e.allDay ? new Date(`${e.startTime.slice(0, 10)}T00:00:00`) : new Date(e.startTime);
+      if (Number.isNaN(start.getTime())) return false;
+      if (filters.when === 'today' && dayKey(start) !== todayKey) return false;
+      if (filters.when === 'upcoming' && start.getTime() < now.getTime() - 3_600_000) return false;
+      if (filters.when === 'past' && start.getTime() > now.getTime()) return false;
+    }
+    return true;
+  });
+}
+
+/** Sort for the agenda/search list: soonest first, then title. */
+export function sortEventsForList(events: CalEvent[], now: Date): CalEvent[] {
+  return [...events].sort((a, b) => {
+    const as = startOf(a);
+    const bs = startOf(b);
+    // Upcoming first (ascending), then past events most-recent-first.
+    const aFuture = as >= now.getTime();
+    const bFuture = bs >= now.getTime();
+    if (aFuture !== bFuture) return aFuture ? -1 : 1;
+    if (aFuture) return as - bs || a.title.localeCompare(b.title);
+    return bs - as || a.title.localeCompare(b.title);
+  });
+}
+
+function startOf(e: CalEvent): number {
+  const d = e.allDay ? new Date(`${e.startTime.slice(0, 10)}T00:00:00`) : new Date(e.startTime);
+  const t = d.getTime();
+  return Number.isNaN(t) ? 0 : t;
+}
+
+/* -------------------------------------------------------------------------- */
+/* Time-grid layout                                                            */
+/* -------------------------------------------------------------------------- */
+
+/** The visible hours of a day/week column, e.g. 07:00 → 22:00. */
+export interface DayWindow {
+  dayStartHour: number;
+  dayEndHour: number;
+}
+
+/** Hour labels for the gutter, inclusive of both ends. */
+export function hourTicks(window: DayWindow): number[] {
+  const out: number[] = [];
+  for (let h = window.dayStartHour; h <= window.dayEndHour; h += 1) out.push(((h % 24) + 24) % 24);
+  return out;
+}
+
+export interface LaidOutOccurrence {
+  occurrence: Occurrence;
+  /** Percentage down the column (0–100). */
+  top: number;
+  /** Percentage of the column height. */
+  height: number;
+  /** Fraction of the column width, and the left offset within it. */
+  width: number;
+  left: number;
+  /** Column index within its cluster. */
+  column: number;
+  columns: number;
+  /** True when the event is visually narrowed by a neighbour. */
+  overlapsOthers: boolean;
+  /** True when the event started before the visible window and is clipped. */
+  clippedTop: boolean;
+  /** True when it runs past the visible window and is clipped. */
+  clippedBottom: boolean;
+}
+
+interface Item {
+  o: Occurrence;
+  start: number;
+  end: number;
+}
+
+/**
+ * Lay out one day's timed occurrences into non-overlapping columns.
+ *
+ * Interval partitioning: sort by start, group into clusters of mutually
+ * overlapping events, then greedily assign each event to the first column whose
+ * previous event has already ended. Widths split evenly across the cluster's
+ * columns with a small overhang so a partially hidden card stays grabbable.
+ *
+ * Occurrences that cross midnight are clipped to the day window and flagged, so
+ * the card can show "until 1:00 AM" rather than stretching into tomorrow.
+ */
+export function layoutDay(occurrences: Occurrence[], day: Date, opts: DayWindow): LaidOutOccurrence[] {
+  const totalMinutes = Math.max(60, (opts.dayEndHour - opts.dayStartHour) * 60);
+  const windowStart = startOfDay(day).getTime() + opts.dayStartHour * 3_600_000;
+  const windowEnd = startOfDay(day).getTime() + opts.dayEndHour * 3_600_000;
+
+  const items: Item[] = [];
+  for (const o of occurrences) {
+    if (o.allDay) continue;
+    const rawStart = o.start.getTime();
+    const rawEnd = o.end.getTime();
+    if (rawEnd <= windowStart || rawStart >= windowEnd) continue;
+
+    const startMin = clampMin((Math.max(rawStart, windowStart) - windowStart) / 60_000, totalMinutes);
+    const endMin = clampMin((Math.min(rawEnd, windowEnd) - windowStart) / 60_000, totalMinutes);
+    items.push({ o, start: startMin, end: Math.max(endMin, startMin + MIN_VISIBLE_MINUTES) });
+  }
+
+  items.sort((a, b) => a.start - b.start || b.end - a.end);
+
+  // Group into clusters of mutually overlapping events.
+  const clusters: Item[][] = [];
+  let current: Item[] = [];
+  let clusterEnd = -Infinity;
+  for (const item of items) {
+    if (current.length && item.start >= clusterEnd) {
+      clusters.push(current);
+      current = [];
+      clusterEnd = -Infinity;
+    }
+    current.push(item);
+    clusterEnd = Math.max(clusterEnd, item.end);
+  }
+  if (current.length) clusters.push(current);
+
+  const out: LaidOutOccurrence[] = [];
+  for (const cluster of clusters) {
+    const columnEnds: number[] = [];
+    const assigned: Array<{ item: Item; col: number }> = [];
+
+    for (const item of cluster) {
+      let col = columnEnds.findIndex((end) => end <= item.start + 0.5);
+      if (col === -1) {
+        col = columnEnds.length;
+        columnEnds.push(item.end);
+      } else {
+        columnEnds[col] = item.end;
+      }
+      assigned.push({ item, col });
+    }
+
+    const columns = Math.max(1, columnEnds.length);
+    const slot = 1 / columns;
+    for (const { item, col } of assigned) {
+      out.push({
+        occurrence: item.o,
+        top: (item.start / totalMinutes) * 100,
+        height: Math.max(MIN_VISIBLE_PCT, ((item.end - item.start) / totalMinutes) * 100),
+        width: columns === 1 ? 1 : slot * 0.92,
+        left: col * slot,
+        column: col,
+        columns,
+        overlapsOthers: columns > 1,
+        clippedTop: item.o.start.getTime() < windowStart,
+        clippedBottom: item.o.end.getTime() > windowEnd,
+      });
+    }
+  }
+  return out;
+}
+
+/** Minimum tap target: 22px at a typical row height. */
+const MIN_VISIBLE_MINUTES = 20;
+const MIN_VISIBLE_PCT = 2.2;
+
+function clampMin(v: number, max: number): number {
+  return Math.min(max, Math.max(0, v));
+}
+
+/* -------------------------------------------------------------------------- */
+/* Labels                                                                      */
+/* -------------------------------------------------------------------------- */
+
+/** "9:00 – 10:30 AM" style compact range for a card. */
+export function timeRangeLabel(o: Occurrence, timeFormat: '12h' | '24h'): string {
+  if (o.allDay) return 'All day';
+  return `${formatTime(o.start, timeFormat)} – ${formatTime(o.end, timeFormat)}`;
+}
+
+export function durationLabel(o: Occurrence): string {
+  if (o.allDay) return 'All day';
+  return fmtMinutes(Math.max(0, differenceInMinutes(o.end, o.start)));
+}
