+              'pressable inline-flex items-center gap-1.5 rounded-full border py-1 pl-1.5 pr-3 text-[12.5px] font-semibold',
+              active
+                ? 'border-[rgb(var(--c-line)/var(--line-strong-alpha))] bg-[rgb(var(--c-line)/0.1)] text-ink'
