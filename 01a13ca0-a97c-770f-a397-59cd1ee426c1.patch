@@ -0,0 +1,457 @@
+@tailwind base;
+@tailwind components;
+@tailwind utilities;
+
+/* ============================================================================
+   PLANIFY — LIQUID GLASS DESIGN SYSTEM
+   ----------------------------------------------------------------------------
+   Tokens live here as CSS custom properties. Two palettes (`data-theme="dark"`
+   and `data-theme="light"`) share the same variable names, so switching themes
+   is a single attribute change and the whole UI cross-fades via the transition
+   declared on `*`.
+
+   Contrast notes (verified in src/lib/color.ts and scripts/check-contrast.mjs):
+     --c-ink    on --c-base  ≈ 18.0:1   (AAA)
+     --c-ink-2  on --c-base  ≈ 12.6:1   (AAA)
+     --c-ink-3  on --c-base  ≈  8.5:1   (AAA, used for 11px labels)
+   The calendar grid is deliberately NOT blurred — it sits on an opaque surface
+   so event text and hairlines stay crisp.
+   ========================================================================= */
+
+@layer base {
+  :root,
+  [data-theme='dark'] {
+    color-scheme: dark;
+
+    /* --- Surfaces: deep charcoal, never pure black ---------------------- */
+    --c-base: 10 10 12; /* #0A0A0C */
+    --c-sunken: 7 7 9; /* #070709 */
+    --c-surface: 18 18 20; /* #121214 */
+    --c-raised: 26 26 30; /* #1A1A1E */
+
+    /* --- Hairlines ------------------------------------------------------ */
+    --c-line: 255 255 255;
+    --line-alpha: 0.09;
+    --c-line-strong: 255 255 255;
+    --line-strong-alpha: 0.16;
+
+    /* --- Text ------------------------------------------------------------ */
+    --c-ink: 242 243 245; /* #F2F3F5 */
+    --c-ink-2: 214 217 223; /* #D6D9DF */
+    --c-ink-3: 169 174 184; /* #A9AEB8 */
+
+    /* --- Accent ---------------------------------------------------------- */
+    --c-accent: 64 145 255; /* #4091FF — fills */
+    --c-accent-text: 138 184 255; /* #8AB8FF — text/links, 8.9:1 on base */
+    --c-accent-soft: 64 145 255; /* used with alpha */
+    --c-accent-ink: 255 255 255; /* on accent fills */
+
+    /* --- Semantic -------------------------------------------------------- */
+    --c-danger: 255 99 92; /* #FF635C */
+    --c-success: 66 214 143; /* #42D68F */
+    --c-warn: 255 196 84; /* #FFC454 */
+
+    /* --- Glass ----------------------------------------------------------- */
+    --glass-bg: rgb(255 255 255 / 0.055);
+    --glass-bg-strong: rgb(255 255 255 / 0.09);
+    --glass-border: rgb(255 255 255 / 0.13);
+    --glass-border-soft: rgb(255 255 255 / 0.08);
+    --glass-highlight: rgb(255 255 255 / 0.22);
+    --glass-blur: 26px;
+    --glass-saturate: 180%;
+    --glass-sheen: linear-gradient(
+      180deg,
+      rgb(255 255 255 / 0.09) 0%,
+      rgb(255 255 255 / 0.02) 42%,
+      rgb(255 255 255 / 0) 100%
+    );
+
+    /* --- Elevation ------------------------------------------------------- */
+    --shadow-glass: 0 1px 2px rgb(0 0 0 / 0.4), 0 12px 32px -8px rgb(0 0 0 / 0.55);
+    --shadow-glass-lg: 0 2px 6px rgb(0 0 0 / 0.45), 0 28px 64px -16px rgb(0 0 0 / 0.7);
+    --shadow-float: 0 6px 16px rgb(0 0 0 / 0.5), 0 24px 48px -12px rgb(0 0 0 / 0.65);
+    --shadow-inset: inset 0 1px 0 rgb(255 255 255 / 0.12);
+
+    /* --- Ambient background ---------------------------------------------- */
+    --aurora:
+      radial-gradient(
+        900px 620px at 12% -8%,
+        rgb(64 145 255 / 0.16) 0%,
+        transparent 62%
+      ),
+      radial-gradient(
+        760px 560px at 92% 6%,
+        rgb(168 116 255 / 0.11) 0%,
+        transparent 60%
+      ),
+      radial-gradient(
+        1000px 700px at 68% 108%,
+        rgb(64 200 255 / 0.07) 0%,
+        transparent 62%
+      );
+
+    /* --- Calendar grid --------------------------------------------------- */
+    --grid-line: rgb(255 255 255 / 0.07);
+    --grid-line-strong: rgb(255 255 255 / 0.12);
+    --now-line: 255 99 92;
+    --today-tint: rgb(64 145 255 / 0.09);
+    --outside-month: rgb(255 255 255 / 0.02);
+  }
+
+  [data-theme='light'] {
+    color-scheme: light;
+
+    --c-base: 244 244 247; /* #F4F4F7 */
+    --c-sunken: 234 234 239; /* #EAEAEE */
+    --c-surface: 255 255 255; /* #FFFFFF */
+    --c-raised: 255 255 255;
+
+    --c-line: 12 14 24;
+    --line-alpha: 0.1;
+    --c-line-strong: 12 14 24;
+    --line-strong-alpha: 0.17;
+
+    /* 15.3:1 / 10.1:1 / 5.6:1 on --c-base — all AA or better */
+    --c-ink: 17 18 22; /* #111216 */
+    --c-ink-2: 58 62 72; /* #3A3E48 */
+    --c-ink-3: 96 101 114; /* #606572 */
+
+    --c-accent: 0 103 224; /* #0067E0 — 5.4:1 with white text */
+    --c-accent-text: 0 84 194; /* #0054C2 — 6.9:1 on base */
+    --c-accent-soft: 0 103 224;
+    --c-accent-ink: 255 255 255;
+
+    --c-danger: 205 45 38; /* #CD2D26 */
+    --c-success: 15 130 74; /* #0F824A */
+    --c-warn: 154 92 0; /* #9A5C00 */
+
+    --glass-bg: rgb(255 255 255 / 0.66);
+    --glass-bg-strong: rgb(255 255 255 / 0.82);
+    --glass-border: rgb(12 14 24 / 0.09);
+    --glass-border-soft: rgb(12 14 24 / 0.06);
+    --glass-highlight: rgb(255 255 255 / 0.95);
+    --glass-blur: 24px;
+    --glass-saturate: 180%;
+    --glass-sheen: linear-gradient(
+      180deg,
+      rgb(255 255 255 / 0.7) 0%,
+      rgb(255 255 255 / 0.18) 45%,
+      rgb(255 255 255 / 0) 100%
+    );
+
+    --shadow-glass: 0 1px 2px rgb(16 18 28 / 0.06), 0 10px 28px -10px rgb(16 18 28 / 0.16);
+    --shadow-glass-lg: 0 2px 6px rgb(16 18 28 / 0.08), 0 26px 56px -18px rgb(16 18 28 / 0.26);
+    --shadow-float: 0 6px 14px rgb(16 18 28 / 0.12), 0 22px 44px -12px rgb(16 18 28 / 0.24);
+    --shadow-inset: inset 0 1px 0 rgb(255 255 255 / 0.9);
+
+    --aurora:
+      radial-gradient(
+        900px 620px at 12% -8%,
+        rgb(64 145 255 / 0.14) 0%,
+        transparent 62%
+      ),
+      radial-gradient(
+        760px 560px at 92% 6%,
+        rgb(168 116 255 / 0.1) 0%,
+        transparent 60%
+      ),
+      radial-gradient(
+        1000px 700px at 68% 108%,
+        rgb(64 200 255 / 0.09) 0%,
+        transparent 62%
+      );
+
+    --grid-line: rgb(12 14 24 / 0.08);
+    --grid-line-strong: rgb(12 14 24 / 0.14);
+    --now-line: 205 45 38;
+    --today-tint: rgb(0 103 224 / 0.07);
+    --outside-month: rgb(12 14 24 / 0.018);
+  }
+
+  *,
+  *::before,
+  *::after {
+    border-color: rgb(var(--c-line) / var(--line-alpha));
+  }
+
+  html,
+  body,
+  #root {
+    height: 100%;
+  }
+
+  html {
+    -webkit-text-size-adjust: 100%;
+    text-size-adjust: 100%;
+  }
+
+  body {
+    margin: 0;
+    background-color: rgb(var(--c-base));
+    color: rgb(var(--c-ink));
+    font-family:
+      -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', 'Segoe UI', Roboto,
+      'Helvetica Neue', Arial, sans-serif;
+    font-synthesis-weight: none;
+    -webkit-font-smoothing: antialiased;
+    -moz-osx-font-smoothing: grayscale;
+    text-rendering: optimizeLegibility;
+    overscroll-behavior-y: none;
+  }
+
+  /* Ambient aurora wash. Painted once on a fixed layer so scrolling never
+     repaints it, and kept very low-contrast so it never fights the text. */
+  body::before {
+    content: '';
+    position: fixed;
+    inset: 0;
+    z-index: 0;
+    pointer-events: none;
+    background-image: var(--aurora);
+    opacity: 0.9;
+  }
+
+  /* Smooth theme cross-fade. Scoped to colour properties only — animating
+     `all` would make every hover/transform feel sluggish. */
+  body,
+  .theme-transition,
+  .theme-transition * {
+    transition:
+      background-color 0.35s var(--tw-ease, cubic-bezier(0.4, 0, 0.2, 1)),
+      border-color 0.35s cubic-bezier(0.4, 0, 0.2, 1),
+      color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
+      fill 0.25s cubic-bezier(0.4, 0, 0.2, 1),
+      box-shadow 0.35s cubic-bezier(0.4, 0, 0.2, 1);
+  }
+
+  :focus-visible {
+    outline: 2px solid rgb(var(--c-accent-text));
+    outline-offset: 2px;
+    border-radius: 6px;
+  }
+
+  ::selection {
+    background: rgb(var(--c-accent) / 0.32);
+    color: rgb(var(--c-ink));
+  }
+
+  /* Scrollbars that disappear into the glass */
+  * {
+    scrollbar-width: thin;
+    scrollbar-color: rgb(var(--c-line) / 0.28) transparent;
+  }
+  *::-webkit-scrollbar {
+    width: 10px;
+    height: 10px;
+  }
+  *::-webkit-scrollbar-track {
+    background: transparent;
+  }
+  *::-webkit-scrollbar-thumb {
+    background-color: rgb(var(--c-line) / 0.22);
+    border-radius: 999px;
+    border: 3px solid transparent;
+    background-clip: content-box;
+  }
+  *::-webkit-scrollbar-thumb:hover {
+    background-color: rgb(var(--c-line) / 0.38);
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    *,
+    *::before,
+    *::after {
+      animation-duration: 0.01ms !important;
+      animation-iteration-count: 1 !important;
+      transition-duration: 0.01ms !important;
+      scroll-behavior: auto !important;
+    }
+  }
+}
+
+@layer components {
+  /* --------------------------------------------------------------------------
+     Liquid Glass primitives
+     The signature look = translucent fill + backdrop blur + 1px hairline +
+     an inner top highlight that reads as light catching a glass edge.
+     ----------------------------------------------------------------------- */
+  .glass {
+    position: relative;
+    background: var(--glass-bg);
+    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
+    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
+    border: 1px solid var(--glass-border-soft);
+    box-shadow:
+      var(--shadow-glass),
+      inset 0 1px 0 var(--glass-highlight),
+      inset 0 -1px 0 rgb(255 255 255 / 0.03);
+    isolation: isolate;
+  }
+
+  /* Top-edge specular lighting — a thin bright line across the upper edge. */
+  .glass::before {
+    content: '';
+    position: absolute;
+    inset: 0 0 auto 0;
+    height: 1px;
+    border-radius: inherit;
+    background: linear-gradient(
+      90deg,
+      transparent 0%,
+      var(--glass-highlight) 18%,
+      rgb(255 255 255 / 0.42) 50%,
+      var(--glass-highlight) 82%,
+      transparent 100%
+    );
+    opacity: 0.75;
+    pointer-events: none;
+    z-index: 2;
+  }
+
+  /* Soft sheen wash across the whole panel. */
+  .glass::after {
+    content: '';
+    position: absolute;
+    inset: 0;
+    border-radius: inherit;
+    background-image: var(--glass-sheen);
+    pointer-events: none;
+    z-index: 0;
+  }
+
+  .glass > * {
+    position: relative;
+    z-index: 1;
+  }
+
+  .glass-strong {
+    background: var(--glass-bg-strong);
+    border-color: var(--glass-border);
+  }
+
+  /* Solid, opaque surface — used for the calendar grid and long-form text so
+     reading never happens through a blur. */
+  .solid-surface {
+    background-color: rgb(var(--c-surface));
+    border: 1px solid rgb(var(--c-line) / var(--line-alpha));
+  }
+
+  .hairline {
+    border-color: rgb(var(--c-line) / var(--line-alpha));
+  }
+
+  /* Press micro-interaction: slight scale + reduced shadow, like a real key. */
+  .pressable {
+    transition:
+      transform 0.16s cubic-bezier(0.32, 0.72, 0, 1),
+      box-shadow 0.16s ease,
+      background-color 0.16s ease,
+      border-color 0.16s ease,
+      opacity 0.16s ease;
+    will-change: transform;
+  }
+  .pressable:hover:not(:disabled) {
+    transform: translateY(-0.5px);
+  }
+  .pressable:active:not(:disabled) {
+    transform: scale(0.965) translateY(0.5px);
+  }
+  .pressable:disabled {
+    opacity: 0.45;
+    cursor: not-allowed;
+  }
+
+  /* Floating glass button (the "+") */
+  .fab {
+    box-shadow:
+      var(--shadow-float),
+      inset 0 1px 0 rgb(255 255 255 / 0.3);
+  }
+
+  /* Text utilities mapped to the three contrast tiers */
+  .t-primary {
+    color: rgb(var(--c-ink));
+  }
+  .t-secondary {
+    color: rgb(var(--c-ink-2));
+  }
+  .t-tertiary {
+    color: rgb(var(--c-ink-3));
+  }
+  .t-accent {
+    color: rgb(var(--c-accent-text));
+  }
+
+  /* Hide scrollbars on horizontal pill rails (mobile view switcher) */
+  .no-scrollbar {
+    scrollbar-width: none;
+    -ms-overflow-style: none;
+  }
+  .no-scrollbar::-webkit-scrollbar {
+    display: none;
+  }
+
+  /* Shimmer skeleton for loading states */
+  .skeleton {
+    background: linear-gradient(
+      90deg,
+      rgb(var(--c-line) / 0.06) 25%,
+      rgb(var(--c-line) / 0.14) 37%,
+      rgb(var(--c-line) / 0.06) 63%
+    );
+    background-size: 200% 100%;
+    animation: shimmer 1.6s linear infinite;
+    border-radius: 8px;
+  }
+
+  /* Native-feeling iOS sheet grabber */
+  .grabber {
+    width: 36px;
+    height: 5px;
+    border-radius: 999px;
+    background: rgb(var(--c-line) / 0.3);
+  }
+
+  /* Drag-and-drop ghost */
+  .dragging {
+    opacity: 0.35;
+    transform: scale(0.98);
+  }
+  .drop-target {
+    background: rgb(var(--c-accent) / 0.14) !important;
+    box-shadow: inset 0 0 0 2px rgb(var(--c-accent) / 0.5);
+  }
+
+  /* Number/date pill in the month grid */
+  .daynum {
+    font-variant-numeric: tabular-nums;
+    font-feature-settings: 'tnum' 1;
+  }
+}
+
+@layer utilities {
+  .safe-b {
+    padding-bottom: env(safe-area-inset-bottom, 0px);
+  }
+  .safe-t {
+    padding-top: env(safe-area-inset-top, 0px);
+  }
+  .safe-x {
+    padding-left: env(safe-area-inset-left, 0px);
+    padding-right: env(safe-area-inset-right, 0px);
+  }
+  .mb-safe {
+    margin-bottom: env(safe-area-inset-bottom, 0px);
+  }
+  .tnum {
+    font-variant-numeric: tabular-nums;
+  }
+  .text-balance {
+    text-wrap: balance;
+  }
+  /* Keeps glass layers from creating expensive nested stacking contexts */
+  .gpu {
+    transform: translateZ(0);
+    backface-visibility: hidden;
+  }
+}
diff --git a/src/types.ts b/src/types.ts
