+  const loc = parseLocation(input, matchedFragments);
+  if (loc) {
+    matchedFragments.push(loc.matched);
+    working = cut(working, loc.matched);
+  }
+
+  /* ---- 8. Title --------------------------------------------------------- */
+  let title = cleanTitle(working, input);
+  if (!title) {
+    title = loc ? titleFromLocation(loc.location) : '';
+  }
+  if (!title) {
+    missing.push('title');
+    title = '';
