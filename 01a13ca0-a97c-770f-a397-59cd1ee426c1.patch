+      emit(authListeners, null);
+    },
+
+    async listEvents(userId) {
+      if (!online()) return idbListEvents(userId);
+      const { data, error } = await supabase
+        .from('events')
+        .select('*')
+        .eq('user_id', userId)
+        .eq('deleted', false)
+        .order('start_time', { ascending: true });
